      current := current + loadedLines[2].Length;
    end;
    if loadedLines.Length >= 4 then
    begin
      current := current + loadedLines[3].Length;
    end;
    if ioText.Contains('alpha') and ioText.Contains('delta') then
    begin
      current := current + 1;
    end;
    if ioHasExtension then
    begin
      current := current + 1;
    end;
    current := current + ioJoinedLines.Length;
    current := current + ioSplitJoinedLines.Length;
    current := current + ioTextLines.Length;
    if ioNilText = nil then
    begin
      current := current + 1;
    end;
    if ioHasEmpty then
    begin
      current := current + 1;
    end;
    current := current + ioRepeated.Length;
    current := current + ioPadLeft.Length;
    current := current + ioPadRight.Length;
    current := current + ioCentered.Length;
    if ioStartsIgnoreCase then
    begin
      current := current + 1;
    end;
    if ioEndsIgnoreCase then
    begin
      current := current + 1;
    end;
    if ioContainsIgnoreCase then
    begin
      current := current + 1;
    end;
    if ioTrimmedToNull = nil then
    begin
      current := current + 1;
    end;
    current := current + ioCollapsedWhitespace.Length;
    current := current + ioIndented.Length;
    current := current + ioFileNameWithoutExtension.Length;
    current := current + ioChangedExtension.Length;
    Program.Trace('CHECKPOINT io=', current);

    Program.TraceText('SECTION collections');
    var words := new StringList();
    words.Add('alpha');
    words.Add('beta');
    var extraWords := new String[2];
    extraWords[0] := 'gamma';
    extraWords[1] := 'delta';
    words.AddRange(extraWords);
    Program.Trace('CHECKPOINT collections-count=', words.Count);
    Program.Trace('CHECKPOINT collections-contains=', words.Contains('beta'));
    Program.Trace('CHECKPOINT collections-index=', words.IndexOf('gamma'));
    var wordsArray := words.ToArray();
    Program.Trace('CHECKPOINT collections-array=', 4);
    current := current + words.Count;
    current := current + words.IndexOf('gamma');
    current := current + 4;
    if words.Contains('beta') then
    begin
      current := current + 1;
    end;
    current := current + words[0].Length;
    var wordView: IList<String> := words;
    current := current + wordView.Count;
    if wordView.Contains('alpha') then
    begin
      current := current + 1;
    end;
    current := current + wordView[1].Length;
    var readonlyWords: IReadOnlyList<String> := words;
    current := current + readonlyWords.Count;
    current := current + readonlyWords[2].Length;
    var wordCollection: ICollection<String> := words;
    current := current + wordCollection.Count;
    if wordCollection.Contains('delta') then
    begin
      current := current + 1;
    end;
    words.Clear();

    var genericWords: List<String> := new List<String>();
    genericWords.Add('one');
    genericWords.Add('two');
    Program.Trace('CHECKPOINT generic-list-count=', genericWords.Count);
    Program.Trace('CHECKPOINT generic-list-contains=', genericWords.Contains('two'));
    current := current + genericWords.Count;
    if genericWords.Contains('two') then
    begin
      current := current + 1;
    end;
    current := current + genericWords[0].Length;
    var genericView: IList<String> := genericWords;
    current := current + genericView.Count;
    current := current + genericView[0].Length;
    var readonlyGenericView: IReadOnlyList<String> := genericWords;
    current := current + readonlyGenericView.Count;
    current := current + readonlyGenericView[1].Length;
    var genericCollection: ICollection<String> := genericWords;
    current := current + genericCollection.Count;
    if genericCollection.Contains('one') then
    begin
      current := current + 1;
    end;
    var genericEnumerable: IEnumerable<String> := genericWords;
    var genericEnumerator := genericEnumerable.GetEnumerator();
    Program.Trace('CHECKPOINT enumerable-before-first-move=', current);
    if genericEnumerator.MoveNext() then
    begin
      current := current + genericEnumerator.Current.Length;
    end;
    Program.Trace('CHECKPOINT enumerable-after-first-move=', current);
    if genericEnumerator.MoveNext() then
    begin
      current := current + genericEnumerator.Current.Length;
    end;
    Program.Trace('CHECKPOINT enumerable-after-second-move=', current);
    genericEnumerator.Reset();
    Program.Trace('CHECKPOINT enumerable-after-reset=', current);
    if genericEnumerator.MoveNext() then
    begin
      current := current + genericEnumerator.Current.Length;
    end;
    Program.Trace('CHECKPOINT enumerable-after-third-move=', current);

    foreach var iteratedWord in genericEnumerable do
    begin
      current := current + iteratedWord.Length;
    end;

    var wordLengths: Dictionary<String, Integer> := new Dictionary<String, Integer>();
    wordLengths.Add('alpha', 5);
    wordLengths['beta'] := 4;
    Program.Trace('CHECKPOINT dictionary-count=', wordLengths.Count);
    Program.Trace('CHECKPOINT dictionary-contains=', wordLengths.ContainsKey('beta'));
    var betaLength: Integer;
    var missingLength: Integer;
    Program.Trace('CHECKPOINT dictionary-try-get=', wordLengths.TryGetValue('beta', out betaLength));
    Program.Trace('CHECKPOINT dictionary-try-miss=', wordLengths.TryGetValue('missing', out missingLength));
    current := current + wordLengths.Count;
    current := current + wordLengths['alpha'];
    if wordLengths.ContainsKey('beta') then
    begin
      current := current + wordLengths['beta'];
    end;
    current := current + betaLength;
    wordLengths.Clear();

    Program.Trace('CHECKPOINT collections=', current);

    Program.TraceText('SECTION diagnostics');
    var stopwatch := Stopwatch.StartNew();
    if stopwatch.IsRunning then
    begin
      current := current + 1;
    end;
    stopwatch.Stop();
    if stopwatch.IsRunning then
    begin
      current := current + 100;
    end
    else
    begin
      current := current + 1;
    end;
    if stopwatch.ElapsedMilliseconds >= 0 then
    begin
      current := current + 1;
    end;
    stopwatch.Reset();
    if stopwatch.ElapsedMilliseconds = 0 then
    begin
      current := current + 1;
    end;
    stopwatch.Restart();
    if stopwatch.IsRunning then
    begin
      current := current + 1;
    end;
    stopwatch.Stop();
    if stopwatch.ElapsedMilliseconds >= 0 then
    begin
      current := current + 1;
    end;

    var manualStopwatch := new Stopwatch();
    if manualStopwatch.IsRunning then
    begin
      current := current + 100;
    end
    else
    begin
      current := current + 1;
    end;
    manualStopwatch.Start();
    if manualStopwatch.IsRunning then
    begin
      current := current + 1;
    end;
    manualStopwatch.Stop();
    if manualStopwatch.IsRunning then
    begin
      current := current + 100;
    end
    else
    begin
      current := current + 1;
    end;
    Program.Trace('CHECKPOINT diagnostics=', current);

    Program.TraceText('SECTION trace');
    var consoleTrace: ITrace := new ConsoleTrace();
    var fileTrace := new FileTrace('tmp/trace-smoke.log');
    File.WriteAllText(fileTrace.FilePath, '');
    var compositeTrace := new CompositeTrace();
    var traceEntries := new ITrace[2];
    traceEntries[0] := consoleTrace;
    traceEntries[1] := fileTrace;
    compositeTrace.Entries := traceEntries;
    var traceTargets := new TraceTarget[2];
    traceTargets[0] := TraceTarget.Console;
    traceTargets[1] := TraceTarget.File;
    compositeTrace.Targets := traceTargets;
    compositeTrace.MinimumLevel := TraceLevel.Debug;
    Trace.Current := compositeTrace;
    Trace.Write('TRACE>');
    Trace.WriteLine('line');
    Trace.WriteInformation('info');
    Trace.WriteWarning('warn');
    Trace.WriteError('error');
    Trace.WriteDebug('debug');

    var traceText := File.ReadAllText(fileTrace.FilePath);
    current := current + compositeTrace.Targets.Length;
    if traceText.Contains('TRACE>') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('line') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[INFO] info') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[WARN] warn') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[ERROR] error') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[DEBUG] debug') then
    begin
      current := current + 1;
    end;
    var nullTrace: ITrace := new NullTrace();
    current := current + nullTrace.Targets.Length;
    Program.Trace('CHECKPOINT trace=', current);

    Program.TraceText('SECTION final-state');
    Program.Trace('CHECKPOINT final-before-store=', current);
    Program.Total := result + current + Program.AutoTotal + Program.SecretRead;
    Program.Trace('SMOKE_RESULT=', Program.Total);
    return;
  end;

  public method Increment;
  begin
    Counter := Counter + 1;
    self.Counter := Counter + 1;
    return;
  end;

  public function Current: Integer;
  begin
    return self.Value;
  end;
end;
