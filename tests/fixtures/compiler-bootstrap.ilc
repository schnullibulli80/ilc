public class Smoke
begin
  public static var CheckCount: Integer;
  public static var Signature: Integer;

  public static method Record(name: String; value: Integer);
  begin
    CheckCount := CheckCount + 1;
    Signature := (Signature * 131 + CheckCount * 17 + name.Length * 31 + value) mod 1000003;
  end;
end;

