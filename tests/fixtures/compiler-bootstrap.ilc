      current := current + 1;
    end;
    var failingResultTask := new Task<Integer>(new TaskFailingResultProbe());
    var taskResultFailureSeen := false;
    try
      failingResultTask.Wait();
    except
      on ex: Exception do
      begin
        taskResultFailureSeen := ex.Message.Contains('task-result-probe-failure');
      end;
    end;
    Program.Trace('CHECKPOINT task-result-failure=', taskResultFailureSeen);
    if taskResultFailureSeen then
    begin
      current := current + 1;
    end;
    threadMutex.Release();
    threadMutex.Close();
    var projector: IntProjector := ProjectDouble;
    var projected := projector(21);
    Program.Trace('CHECKPOINT delegate-invoke=', projected = 42);
    if projected = 42 then
    begin
      current := current + 1;
    end;
    var lambdaProjector: IntProjector := function(value: Integer): Integer => value * 3;
    var lambdaProjected := lambdaProjector(14);
    Program.Trace('CHECKPOINT delegate-lambda=', lambdaProjected = 42);
    if lambdaProjected = 42 then
    begin
      current := current + 1;
    end;
    var lambdaFactor := 3;
    var capturingProjector: IntProjector := function(value: Integer): Integer => value * lambdaFactor;
    var capturedProjected := capturingProjector(14);
    Program.Trace('CHECKPOINT delegate-capture=', capturedProjected = 42);
    if capturedProjected = 42 then
    begin
      current := current + 1;
    end;
    Program.Trace('CHECKPOINT threading=', current);

    Program.TraceText('SECTION diagnostics');
    var stopwatch := Stopwatch.StartNew();
    if stopwatch.IsRunning then
    begin
      current := current + 1;
    end;
    stopwatch.Stop();
    if stopwatch.IsRunning then
    begin
      current := current + 100;
    end
    else
    begin
      current := current + 1;
    end;
    if stopwatch.ElapsedMilliseconds >= 0 then
    begin
      current := current + 1;
    end;
    stopwatch.Reset();
    if stopwatch.ElapsedMilliseconds = 0 then
    begin
      current := current + 1;
    end;
    stopwatch.Restart();
    if stopwatch.IsRunning then
    begin
      current := current + 1;
    end;
    stopwatch.Stop();
    if stopwatch.ElapsedMilliseconds >= 0 then
    begin
      current := current + 1;
    end;

    var manualStopwatch := new Stopwatch();
    if manualStopwatch.IsRunning then
    begin
      current := current + 100;
    end
    else
    begin
      current := current + 1;
    end;
    manualStopwatch.Start();
    if manualStopwatch.IsRunning then
    begin
      current := current + 1;
    end;
    manualStopwatch.Stop();
    if manualStopwatch.IsRunning then
    begin
      current := current + 100;
    end
    else
    begin
      current := current + 1;
    end;
    Program.Trace('CHECKPOINT diagnostics=', current);

    Program.TraceText('SECTION trace');
    var consoleTrace: ITrace := new ConsoleTrace();
    var fileTrace := new FileTrace('tmp/trace-smoke.log');
    File.WriteAllText(fileTrace.FilePath, '');
    var compositeTrace := new CompositeTrace();
    var traceEntries := new ITrace[2];
    traceEntries[0] := consoleTrace;
    traceEntries[1] := fileTrace;
    compositeTrace.Entries := traceEntries;
    var traceTargets := new TraceTarget[2];
    traceTargets[0] := TraceTarget.Console;
    traceTargets[1] := TraceTarget.File;
    compositeTrace.Targets := traceTargets;
    compositeTrace.MinimumLevel := TraceLevel.Debug;
    Trace.Current := compositeTrace;
    Trace.Write('TRACE>');
    Trace.WriteLine('line');
    Trace.WriteInformation('info');
    Trace.WriteWarning('warn');
    Trace.WriteError('error');
    Trace.WriteDebug('debug');

    var traceText := File.ReadAllText(fileTrace.FilePath);
    current := current + compositeTrace.Targets.Length;
    if traceText.Contains('TRACE>') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('line') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[INFO] info') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[WARN] warn') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[ERROR] error') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[DEBUG] debug') then
    begin
      current := current + 1;
    end;
    var nullTrace: ITrace := new NullTrace();
    current := current + nullTrace.Targets.Length;
    Program.Trace('CHECKPOINT trace=', current);

    Program.TraceText('SECTION final-state');
    Program.Trace('CHECKPOINT final-before-store=', current);
    Program.Total := localResult + current + Program.AutoTotal + Program.SecretRead;
    System.Console.WriteLine('SMOKE_CHECKS=' + Smoke.CheckCount.ToString());
    System.Console.WriteLine('SMOKE_SIGNATURE=' + Smoke.Signature.ToString());
    System.Console.WriteLine('SMOKE_RESULT=' + Program.Total.ToString());
    return;
  end;

  // Increment the counter by 2 to verify that both direct field access and property access work in the same method.
  public method Increment;
  begin
    Counter := Counter + 1;
    self.Counter := Counter + 1;
    return;
  end;

  // Return the current value to verify that property getters work correctly.
  public function Current: Integer;
  begin
    return self.Value;
  end;
end;
