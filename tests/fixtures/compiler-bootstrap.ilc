    if httpBody = 'hello:ilc' then
    begin
      current := current + 9;
    end;
    var wsPortText := Environment.Variables['ILC_WS_SMOKE_PORT'];
    var wsConnected := false;
    var wsResponse := '';
    var wsClient := new WebSocketClient();
    if wsPortText <> nil then
    begin
      wsConnected := wsClient.Connect('ws://127.0.0.1:' + wsPortText + '/echo');
    end;
    Program.Trace('CHECKPOINT net-ws-connect=', wsConnected);
    if wsConnected then
    begin
      wsClient.SendText('ping');
      wsResponse := wsClient.ReceiveText();
      Program.Trace('CHECKPOINT net-ws-response=', wsResponse = 'echo:ping');
      if wsResponse = 'echo:ping' then
      begin
        current := current + 9;
      end;
      wsClient.Close();
      Program.Trace('CHECKPOINT net-ws-closed=', wsClient.IsConnected);
      if not wsClient.IsConnected then
      begin
        current := current + 1;
      end;
    end;
    Program.Trace('CHECKPOINT net=', current);

    Program.TraceText('SECTION threading');
    var currentThreadId := Thread.CurrentManagedId;
    Program.Trace('CHECKPOINT threading-id=', currentThreadId > 0);
    if currentThreadId > 0 then
    begin
      current := current + 1;
    end;
    var threadMutex := new Mutex();
    var threadLockTaken := threadMutex.WaitOne();
    Program.Trace('CHECKPOINT threading-mutex=', threadLockTaken);
    if threadLockTaken then
    begin
      current := current + 1;
    end;
    var sleepStopwatch := Stopwatch.StartNew();
    Thread.Sleep(5);
    Program.Trace('CHECKPOINT threading-sleep=', sleepStopwatch.ElapsedMilliseconds >= 0);
    if sleepStopwatch.ElapsedMilliseconds >= 0 then
    begin
      current := current + 1;
    end;
    var threadProbe := new ThreadProbe();
    var workerThread := Thread.Start(threadProbe);
    workerThread.Join();
    Program.Trace('CHECKPOINT threading-start=', threadProbe.Value = 42);
    if threadProbe.Value = 42 then
    begin
      current := current + 1;
    end;
    Program.Trace('CHECKPOINT threading-joined=', workerThread.IsAlive);
    if not workerThread.IsAlive then
    begin
      current := current + 1;
    end;
    var failingThreadProbe := new ThreadFailingProbe();
    var failingThread := Thread.Start(failingThreadProbe);
    var threadFailureSeen := false;
    try
      failingThread.Join();
    except
      on ex: Exception do
      begin
        threadFailureSeen := ex.Message.Contains('thread-probe-failure');
      end;
    end;
    Program.Trace('CHECKPOINT threading-failure=', threadFailureSeen);
    if threadFailureSeen then
    begin
      current := current + 1;
    end;
    var successTask := Task.Run(new ThreadProbe());
    successTask.Wait();
    Program.Trace('CHECKPOINT task-success=', successTask.IsCompleted and not successTask.IsFaulted);
    if successTask.IsCompleted and not successTask.IsFaulted then
    begin
      current := current + 1;
    end;
    var failingTask := Task.Run(new ThreadFailingProbe());
    var taskFailureSeen := false;
    try
      failingTask.Wait();
    except
      on ex: Exception do
      begin
        taskFailureSeen := ex.Message.Contains('thread-probe-failure');
      end;
    end;
    Program.Trace('CHECKPOINT task-failure=', taskFailureSeen);
    if taskFailureSeen then
    begin
      current := current + 1;
    end;
    var successResultTask := new Task<Integer>(new TaskResultProbe());
    successResultTask.Wait();
    Program.Trace('CHECKPOINT task-result=', successResultTask.Result = 42);
    if successResultTask.Result = 42 then
    begin
      current := current + 1;
    end;
    var failingResultTask := new Task<Integer>(new TaskFailingResultProbe());
    var taskResultFailureSeen := false;
    try
      failingResultTask.Wait();
    except
      on ex: Exception do
      begin
        taskResultFailureSeen := ex.Message.Contains('task-result-probe-failure');
      end;
    end;
    Program.Trace('CHECKPOINT task-result-failure=', taskResultFailureSeen);
    if taskResultFailureSeen then
    begin
      current := current + 1;
    end;
    threadMutex.Release();
    threadMutex.Close();
    var projector: IntProjector := ProjectDouble;
    var projected := projector(21);
    Program.Trace('CHECKPOINT delegate-invoke=', projected = 42);
    if projected = 42 then
    begin
      current := current + 1;
    end;
    var lambdaProjector: IntProjector := function(value: Integer): Integer => value * 3;
    var lambdaProjected := lambdaProjector(14);
    Program.Trace('CHECKPOINT delegate-lambda=', lambdaProjected = 42);
    if lambdaProjected = 42 then
    begin
      current := current + 1;
    end;
    var lambdaFactor := 3;
    var capturingProjector: IntProjector := function(value: Integer): Integer => value * lambdaFactor;
    var capturedProjected := capturingProjector(14);
    Program.Trace('CHECKPOINT delegate-capture=', capturedProjected = 42);
    if capturedProjected = 42 then
    begin
      current := current + 1;
    end;
    Program.Trace('CHECKPOINT threading=', current);

    Program.TraceText('SECTION diagnostics');
    var stopwatch := Stopwatch.StartNew();
    if stopwatch.IsRunning then
    begin
      current := current + 1;
    end;
    stopwatch.Stop();
    if stopwatch.IsRunning then
    begin
      current := current + 100;
    end
    else
    begin
      current := current + 1;
    end;
    if stopwatch.ElapsedMilliseconds >= 0 then
    begin
      current := current + 1;
    end;
    stopwatch.Reset();
    if stopwatch.ElapsedMilliseconds = 0 then
    begin
      current := current + 1;
    end;
    stopwatch.Restart();
    if stopwatch.IsRunning then
    begin
      current := current + 1;
    end;
    stopwatch.Stop();
    if stopwatch.ElapsedMilliseconds >= 0 then
    begin
      current := current + 1;
    end;

    var manualStopwatch := new Stopwatch();
    if manualStopwatch.IsRunning then
    begin
      current := current + 100;
    end
    else
    begin
      current := current + 1;
    end;
    manualStopwatch.Start();
    if manualStopwatch.IsRunning then
    begin
      current := current + 1;
    end;
    manualStopwatch.Stop();
    if manualStopwatch.IsRunning then
    begin
      current := current + 100;
    end
    else
    begin
      current := current + 1;
    end;
    Program.Trace('CHECKPOINT diagnostics=', current);

    Program.TraceText('SECTION trace');
    var consoleTrace: ITrace := new ConsoleTrace();
    var fileTrace := new FileTrace('tmp/trace-smoke.log');
    File.WriteAllText(fileTrace.FilePath, '');
    var compositeTrace := new CompositeTrace();
    var traceEntries := new ITrace[2];
    traceEntries[0] := consoleTrace;
    traceEntries[1] := fileTrace;
    compositeTrace.Entries := traceEntries;
    var traceTargets := new TraceTarget[2];
    traceTargets[0] := TraceTarget.Console;
    traceTargets[1] := TraceTarget.File;
    compositeTrace.Targets := traceTargets;
    compositeTrace.MinimumLevel := TraceLevel.Debug;
    Trace.Current := compositeTrace;
    Trace.Write('TRACE>');
    Trace.WriteLine('line');
    Trace.WriteInformation('info');
    Trace.WriteWarning('warn');
    Trace.WriteError('error');
    Trace.WriteDebug('debug');

    var traceText := File.ReadAllText(fileTrace.FilePath);
    current := current + compositeTrace.Targets.Length;
    if traceText.Contains('TRACE>') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('line') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[INFO] info') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[WARN] warn') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[ERROR] error') then
    begin
      current := current + 1;
    end;
    if traceText.Contains('[DEBUG] debug') then
    begin
      current := current + 1;
    end;
    var nullTrace: ITrace := new NullTrace();
    current := current + nullTrace.Targets.Length;
    Program.Trace('CHECKPOINT trace=', current);

    Program.TraceText('SECTION final-state');
    Program.Trace('CHECKPOINT final-before-store=', current);
    Program.Total := result + current + Program.AutoTotal + Program.SecretRead;
    Program.Trace('SMOKE_RESULT=', Program.Total);
    return;
  end;

  // Increment the counter by 2 to verify that both direct field access and property access work in the same method.
  public method Increment;
  begin
    Counter := Counter + 1;
    self.Counter := Counter + 1;
    return;
  end;

  // Return the current value to verify that property getters work correctly.
  public function Current: Integer;
  begin
    return self.Value;
  end;
end;
