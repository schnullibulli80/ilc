//
// Author   : Patrik Graf
// GitHub   : https://github.com/schnullibulli80
// Comment  : This file contains the diagnostics and tracing surface of the shipped ILC library. It provides stopwatch support,
//            trace abstractions, concrete trace targets, and the static Trace facade used by fixtures and higher-level libraries.
//            The implementation stays intentionally bootstrap-friendly and relies on the existing system and host services.
//
// Type     : ILC source code fixture
// Date     : 2026-04-05
// History  :
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
namespace System.Diagnostics;

uses System;

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • ENUM • TraceLevel
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Defines the verbosity or severity level of a trace message.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public enum TraceLevel
begin
  Debug;
  Information;
  Warning;
  Error;
end;
//══ end of enum ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • ENUM • TraceTarget
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Defines the output targets supported by the bootstrap trace implementation.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public enum TraceTarget
begin
  Console;
  File;
  Null;
end;
//══ end of enum ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • INTERFACE • ITrace
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Defines the common tracing surface used by all diagnostics targets.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public interface ITrace
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the trace targets supported by this trace instance.</summary>
  public property Targets: array of TraceTarget { get; set; };
  /// <summary>Gets or sets the minimum trace level.</summary>
  public property MinimumLevel: TraceLevel { get; set; };

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Write
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the default information level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Write(text: String);

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the default information level including a newline.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteLine(text: String);

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteDebug
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the debug level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————  
  public method WriteDebug(text: String);

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteInformation
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the information level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteInformation(text: String);

  // ———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteWarning
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the warning level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteWarning(text: String);

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteError
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the error level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteError(text: String);

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteErrorWithStackTrace
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the error level including a stack trace.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteErrorWithStackTrace(text: String);
end;
//══ end of interface ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Stopwatch
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Provides a lightweight stopwatch based on monotonic host time.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Stopwatch
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Ticks at the moment the stopwatch was started.</summary>
  private var StartTick: Integer;
  /// <summary>Ticks accumulated from previous start/stop cycles.</summary>
  private var ElapsedTick: Integer;
  /// <summary>Indicates whether the stopwatch is currently running.</summary>
  private var Running: Boolean;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets a value indicating whether the stopwatch is currently running.</summary>
  public property IsRunning: Boolean
  begin
    get
    begin
      return Running;
    end;
  end;
  
  /// <summary>Gets the total elapsed time in milliseconds.</summary>
  public property ElapsedMilliseconds: Integer
  begin
    get
    begin
      if Running then
      begin
        return ElapsedTick + (CurrentTick() - StartTick);
      end;

      return ElapsedTick;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the Stopwatch class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    StartTick := 0;
    ElapsedTick := 0;
    Running := false;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • CurrentTick
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Retrieves the current tick count from the monotonic host clock.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static function CurrentTick: Integer;
  begin
    return Integer.Parse(Clock.MonotonicMillisecondsText);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • StartNew
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Creates and starts a new Stopwatch instance.</summary>
  /// <returns>A started Stopwatch instance.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static function StartNew: Stopwatch;
  begin
    var stopwatch := new Stopwatch();
    stopwatch.Start();
    return stopwatch;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Start
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Starts or resumes the stopwatch.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Start;
  begin
    if not Running then
    begin
      StartTick := CurrentTick();
      Running := true;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Stop
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Stops or pauses the stopwatch.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Stop;
  begin
    if Running then
    begin
      ElapsedTick := ElapsedMilliseconds;
      Running := false;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Restart
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Restarts the stopwatch.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Restart;
  begin
    ElapsedTick := 0;
    StartTick := CurrentTick();
    Running := true;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Reset
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Resets the stopwatch.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Reset;
  begin
    StartTick := 0;
    ElapsedTick := 0;
    Running := false;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • TraceFormatting
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Provides shared formatting helpers for trace implementations.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class TraceFormatting
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • NewLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Retrieves the newline string for the current environment.</summary>
  /// <returns>A string representing the newline sequence.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static function NewLine: String;
  begin
    return '
';
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • LevelText
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the text representation of a trace level.</summary>
  /// <param name="level">The trace level.</param>
  /// <returns>A string representing the trace level.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static function LevelText(level: TraceLevel): String;
  begin
    if level = TraceLevel.Debug then
    begin
      return 'DEBUG';
    end;

    if level = TraceLevel.Information then
    begin
      return 'INFO';
    end;

    if level = TraceLevel.Warning then
    begin
      return 'WARN';
    end;

    return 'ERROR';
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Prefix
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Formats a trace message prefix with timestamp and level information.</summary>
  /// <param name="level">The trace level to include in the prefix.</param>
  /// <returns>A string representing the trace message prefix.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static function Prefix(level: TraceLevel): String;
  begin
    return '[' + Clock.WallDateTimeText + '] [' + LevelText(level) + '] ';
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • AppendLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Appends a newline character to the specified text.</summary>
  /// <param name="text">The text to which to append a newline.</param>
  /// <returns>A string representing the text with a newline appended.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static function AppendLine(text: String): String;
  begin
    return text + NewLine();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • GetCurrentStackTraceText
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Retrieves the current formatted stack trace text from the runtime.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static function GetCurrentStackTraceText: String;
  begin
    return Exception.CurrentStackTrace;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • ConsoleTrace
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Writes trace output to the console target with timestamp and level prefixing.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class ConsoleTrace: ITrace
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Holds the trace targets supported by this trace instance.</summary>
  private var TargetKinds: array of TraceTarget;
  /// <summary>Holds the minimum trace level for this trace instance.</summary>
  private var MinimumLevelValue: TraceLevel;
  /// <summary>Indicates whether there is a pending trace fragment that has not yet been flushed to the console.</summary>
  private var HasPending: Boolean;
  /// <summary>Holds the text of the pending trace fragment that has not yet been flushed to the console.</summary>
  private var PendingText: String;
  /// <summary>Holds the trace level of the pending trace fragment that has not yet been flushed to the console.</summary>
  private var PendingLevel: TraceLevel;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the trace targets supported by this trace instance.</summary>
  public property Targets: array of TraceTarget
  begin
    get
    begin
      return TargetKinds;
    end;

    set(value)
    begin
      TargetKinds := value;
    end;
  end;

  /// <summary>Gets or sets the minimum trace level.</summary>
  public property MinimumLevel: TraceLevel
  begin
    get
    begin
      return MinimumLevelValue;
    end;

    set(value)
    begin
      MinimumLevelValue := value;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the ConsoleTrace class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    TargetKinds := new TraceTarget[1];
    TargetKinds[0] := TraceTarget.Console;
    MinimumLevelValue := TraceLevel.Debug;
    HasPending := false;
    PendingText := '';
      PendingLevel := TraceLevel.Information;
  end;
  
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • ShouldWrite
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Determines whether a trace message with the specified level should be written based on the minimum level setting.</summary>
  /// <param name="level">The trace level of the message to check.</param>
  /// <returns>true if the message should be written; otherwise, false.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private function ShouldWrite(level: TraceLevel): Boolean;
  begin
    return level >= MinimumLevelValue;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • FlushPending
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Flushes the pending trace fragment to the console.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private method FlushPending;
  begin
    if HasPending then
    begin
      Console.WriteLine(TraceFormatting.Prefix(PendingLevel) + PendingText);
      PendingText := '';
      HasPending := false;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • EmitFragment
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>
  ///   Emits a trace fragment with the specified level and text. If there is an existing pending fragment with the same level, the text is
  ///   appended to it; otherwise, the existing pending fragment is flushed and a new pending fragment is created.
  /// </summary>
  /// <param name="level">The trace level of the fragment to emit.</param>
  /// <param name="text">The text of the fragment to emit.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private method EmitFragment(level: TraceLevel; text: String);
  begin
    if not ShouldWrite(level) then
    begin
      return;
    end;

    if HasPending and PendingLevel = level then
    begin
      PendingText := PendingText + text;
    end
    else
    begin
      FlushPending();
      PendingText := text;
      PendingLevel := level;
      HasPending := true;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • EmitLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>
  ///   Emits a trace line with the specified level and text. If there is an existing pending fragment with the same level, the text is
  ///   appended to it; otherwise, the existing pending fragment is flushed and a new pending fragment is created.
  /// </summary>
  /// <param name="level">The trace level of the line to emit.</param>
  /// <param name="text">The text of the line to emit.</param>
  /// <param name="continuePending">A value indicating whether to continue the pending fragment.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private method EmitLine(level: TraceLevel; text: String; continuePending: Boolean);
  begin
    if not ShouldWrite(level) then
    begin
      return;
    end;

    if continuePending and HasPending and PendingLevel = level then
    begin
      Console.WriteLine(TraceFormatting.Prefix(level) + PendingText + text);
      PendingText := '';
      HasPending := false;
      return;
    end;

    FlushPending();
    Console.WriteLine(TraceFormatting.Prefix(level) + text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Write
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the default information level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Write(text: String);
  begin
    EmitFragment(TraceLevel.Information, text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the default information level including a newline.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteLine(text: String);
  begin
    EmitLine(TraceLevel.Information, text, true);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteDebug
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the debug level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteDebug(text: String);
  begin
    EmitLine(TraceLevel.Debug, text, false);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteInformation
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the information level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteInformation(text: String);
  begin
    EmitLine(TraceLevel.Information, text, false);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteWarning
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the warning level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteWarning(text: String);
  begin
    EmitLine(TraceLevel.Warning, text, false);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteError
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the error level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteError(text: String);
  begin
    EmitLine(TraceLevel.Error, text, false);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteErrorWithStackTrace
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the error level and stack trace.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteErrorWithStackTrace(text: String);
  begin
    EmitLine(TraceLevel.Error, text, false);
    EmitLine(TraceLevel.Error, TraceFormatting.GetCurrentStackTraceText(), false);
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • FileTrace
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Writes formatted trace output into a text file.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class FileTrace: ITrace
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Holds the trace targets supported by this trace instance.</summary>
  private var TargetKinds: array of TraceTarget;
  /// <summary>Holds the minimum trace level for this trace instance.</summary>
  private var MinimumLevelValue: TraceLevel;
  /// <summary>Holds the file path to which trace messages will be written.</summary>
  private var FilePathValue: String;
  /// <summary>Indicates whether there is a pending trace fragment that has not yet been flushed to the file.</summary>
  private var HasPending: Boolean;
  /// <summary>Holds the text of the pending trace fragment that has not yet been flushed to the file.</summary>
  private var PendingText: String;
  /// <summary>Holds the trace level of the pending trace fragment that has not yet been flushed to the file.</summary>
  private var PendingLevel: TraceLevel;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the trace targets supported by this trace instance.</summary>
  public property Targets: array of TraceTarget
  begin
    get
    begin
      return TargetKinds;
    end;

    set(value)
    begin
      TargetKinds := value;
    end;
  end;

  /// <summary>Gets or sets the minimum trace level.</summary>
  public property MinimumLevel: TraceLevel
  begin
    get
    begin
      return MinimumLevelValue;
    end;

    set(value)
    begin
      MinimumLevelValue := value;
    end;
  end;

  /// <summary>Gets or sets the file path to which trace messages will be written.</summary>
  public property FilePath: String
  begin
    get
    begin
      return FilePathValue;
    end;

    set(value)
    begin
      FilePathValue := value;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the FileTrace class with the specified file path.</summary>
  /// <param name="path">The file path to which trace messages will be written.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor(path: String);
  begin
    TargetKinds := new TraceTarget[1];
    TargetKinds[0] := TraceTarget.File;
    MinimumLevelValue := TraceLevel.Debug;
    FilePathValue := path;
    HasPending := false;
    PendingText := '';
    PendingLevel := TraceLevel.Information;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • ShouldWrite
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Determines whether a trace message with the specified level should be written based on the minimum level setting.</summary>
  /// <param name="level">The trace level of the message to check.</param>
  /// <returns>true if the message should be written; otherwise, false.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private function ShouldWrite(level: TraceLevel): Boolean;
  begin
    return level >= MinimumLevelValue;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • FlushPending
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Flushes the pending trace fragment to the file.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private method FlushPending;
  begin
    if HasPending then
    begin
      File.AppendAllText(FilePathValue, TraceFormatting.AppendLine(TraceFormatting.Prefix(PendingLevel) + PendingText));
      PendingText := '';
      HasPending := false;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • EmitFragment
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>
  ///   Emits a trace fragment with the specified level and text. If there is an existing pending fragment with the same level, the text is
  ///   appended to it; otherwise, the existing pending fragment is flushed and a new pending fragment is created.
  /// </summary>
  /// <param name="level">The trace level of the fragment to emit.</param>
  /// <param name="text">The text of the fragment to emit.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private method EmitFragment(level: TraceLevel; text: String);
  begin
    if not ShouldWrite(level) then
    begin
      return;
    end;

    if FilePathValue = nil or FilePathValue = '' then
    begin
      return;
    end;

    if HasPending and PendingLevel = level then
    begin
      PendingText := PendingText + text;
    end
    else
    begin
      FlushPending();
      PendingText := text;
      PendingLevel := level;
      HasPending := true;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • EmitLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>
  ///   Emits a trace line with the specified level and text. If there is an existing pending fragment with the same level, the text is appended
  ///   to it; otherwise, the existing pending fragment is flushed and a new pending fragment is created.
  /// </summary>
  /// <param name="level">The trace level of the line to emit.</param>
  /// <param name="text">The text of the line to emit.</param>
  /// <param name="continuePending">A value indicating whether to continue the pending fragment.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private method EmitLine(level: TraceLevel; text: String; continuePending: Boolean);
  begin
    if not ShouldWrite(level) then
    begin
      return;
    end;

    if FilePathValue = nil or FilePathValue = '' then
    begin
      return;
    end;

    if continuePending and HasPending and PendingLevel = level then
    begin
      File.AppendAllText(FilePathValue, TraceFormatting.AppendLine(TraceFormatting.Prefix(level) + PendingText + text));
      PendingText := '';
      HasPending := false;
      return;
    end;

    FlushPending();
    File.AppendAllText(FilePathValue, TraceFormatting.AppendLine(TraceFormatting.Prefix(level) + text));
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Write
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the default information level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Write(text: String);
  begin
    EmitFragment(TraceLevel.Information, text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the default information level including a newline.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteLine(text: String);
  begin
    EmitLine(TraceLevel.Information, text, true);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteDebug
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the debug level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteDebug(text: String);
  begin
    EmitLine(TraceLevel.Debug, text, false);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteInformation
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the information level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteInformation(text: String);
  begin
    EmitLine(TraceLevel.Information, text, false);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteWarning
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the warning level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteWarning(text: String);
  begin
    EmitLine(TraceLevel.Warning, text, false);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteError
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the error level.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteError(text: String);
  begin
    EmitLine(TraceLevel.Error, text, false);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteErrorWithStackTrace
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the error level and stack trace.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteErrorWithStackTrace(text: String);
  begin
    EmitLine(TraceLevel.Error, text, false);
    EmitLine(TraceLevel.Error, TraceFormatting.GetCurrentStackTraceText(), false);
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • NullTrace
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Implements a sink trace that discards all output.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class NullTrace: ITrace
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Holds the trace targets supported by this trace instance.</summary>
  private var TargetKinds: array of TraceTarget;
  /// <summary>Holds the minimum trace level for this trace instance.</summary>
  private var MinimumLevelValue: TraceLevel;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the trace targets supported by this trace instance.</summary>
  public property Targets: array of TraceTarget
  begin
    get
    begin
      return TargetKinds;
    end;

    set(value)
    begin
      TargetKinds := value;
    end;
  end;

  /// <summary>Gets or sets the minimum trace level for this trace instance.</summary>
  public property MinimumLevel: TraceLevel
  begin
    get
    begin
      return MinimumLevelValue;
    end;

    set(value)
    begin
      MinimumLevelValue := value;
    end;
  end;
  
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the NullTrace class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    TargetKinds := new TraceTarget[1];
    TargetKinds[0] := TraceTarget.Null;
    MinimumLevelValue := TraceLevel.Debug;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Write
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Discards the specified trace message.</summary>
  /// <param name="text">The message to discard.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Write(text: String);
  begin
    return;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Discards the specified trace message.</summary>
  /// <param name="text">The message to discard.</param>
  
  public method WriteLine(text: String);
  begin
    return;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteDebug
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Discards the specified trace message.</summary>
  /// <param name="text">The message to discard.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteDebug(text: String);
  begin
    return;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteInformation
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Discards the specified trace message.</summary>
  /// <param name="text">The message to discard.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteInformation(text: String);
  begin
    return;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteWarning
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Discards the specified trace message.</summary>
  /// <param name="text">The message to discard.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteWarning(text: String);
  begin
    return;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteError
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Discards the specified trace message.</summary>
  /// <param name="text">The message to discard.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteError(text: String);
  begin
    return;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteErrorWithStackTrace
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Discards the specified trace message.</summary>
  /// <param name="text">The message to discard.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteErrorWithStackTrace(text: String);
  begin
    return;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • CompositeTrace
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Dispatches trace calls to all configured trace targets.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class CompositeTrace: ITrace
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Holds the list of trace targets to which trace calls will be dispatched.</summary>
  private var EntryList: array of ITrace;
  /// <summary>Holds the trace targets supported by this trace instance.</summary>
  private var TargetKinds: array of TraceTarget;
  /// <summary>Holds the minimum trace level for this trace instance.</summary>
  private var MinimumLevelValue: TraceLevel;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the list of trace targets to which trace calls will be dispatched.</summary>
  public property Entries: array of ITrace
  begin
    get
    begin
      return EntryList;
    end;

    set(value)
    begin
      EntryList := value;
    end;
  end;

  /// <summary>Gets or sets the trace targets supported by this trace instance.</summary>
  public property Targets: array of TraceTarget
  begin
    get
    begin
      return TargetKinds;
    end;

    set(value)
    begin
      TargetKinds := value;
    end;
  end;

  /// <summary>Gets or sets the minimum trace level for this trace instance.</summary>
  public property MinimumLevel: TraceLevel
  begin
    get
    begin
      return MinimumLevelValue;
    end;

    set(value)
    begin
      MinimumLevelValue := value;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the CompositeTrace class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    EntryList := new ITrace[0];
    TargetKinds := new TraceTarget[0];
    MinimumLevelValue := TraceLevel.Debug;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • DispatchWrite
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Dispatches a Write call to the specified trace target.</summary>
  /// <param name="target">The trace target to which the call will be dispatched.</param>
  /// <param name="text">The text to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static method DispatchWrite(target: ITrace; text: String);
  begin
    var composite := target as CompositeTrace;
    if composite <> nil then
    begin
      composite.Write(text);
      return;
    end;

    var console := target as ConsoleTrace;
    if console <> nil then
    begin
      console.Write(text);
      return;
    end;

    var file := target as FileTrace;
    if file <> nil then
    begin
      file.Write(text);
      return;
    end;

    var none := target as NullTrace;
    if none <> nil then
    begin
      none.Write(text);
      return;
    end;

    target.Write(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • DispatchWriteLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Dispatches a WriteLine call to the specified trace target.</summary>
  /// <param name="target">The trace target to which the call will be dispatched.</param>
  /// <param name="text">The text to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static method DispatchWriteLine(target: ITrace; text: String);
  begin
    var composite := target as CompositeTrace;
    if composite <> nil then
    begin
      composite.WriteLine(text);
      return;
    end;

    var console := target as ConsoleTrace;
    if console <> nil then
    begin
      console.WriteLine(text);
      return;
    end;

    var file := target as FileTrace;
    if file <> nil then
    begin
      file.WriteLine(text);
      return;
    end;

    var none := target as NullTrace;
    if none <> nil then
    begin
      none.WriteLine(text);
      return;
    end;

    target.WriteLine(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • DispatchWriteDebug
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Dispatches a WriteDebug call to the specified trace target.</summary>
  /// <param name="target">The trace target to which the call will be dispatched.</param>
  /// <param name="text">The text to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static method DispatchWriteDebug(target: ITrace; text: String);
  begin
    var composite := target as CompositeTrace;
    if composite <> nil then
    begin
      composite.WriteDebug(text);
      return;
    end;

    var console := target as ConsoleTrace;
    if console <> nil then
    begin
      console.WriteDebug(text);
      return;
    end;

    var file := target as FileTrace;
    if file <> nil then
    begin
      file.WriteDebug(text);
      return;
    end;

    var none := target as NullTrace;
    if none <> nil then
    begin
      none.WriteDebug(text);
      return;
    end;

    target.WriteDebug(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • DispatchWriteInformation
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Dispatches a WriteInformation call to the specified trace target.</summary>
  /// <param name="target">The trace target to which the call will be dispatched.</param>
  /// <param name="text">The text to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static method DispatchWriteInformation(target: ITrace; text: String);
  begin
    var composite := target as CompositeTrace;
    if composite <> nil then
    begin
      composite.WriteInformation(text);
      return;
    end;

    var console := target as ConsoleTrace;
    if console <> nil then
    begin
      console.WriteInformation(text);
      return;
    end;

    var file := target as FileTrace;
    if file <> nil then
    begin
      file.WriteInformation(text);
      return;
    end;

    var none := target as NullTrace;
    if none <> nil then
    begin
      none.WriteInformation(text);
      return;
    end;

    target.WriteInformation(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • DispatchWriteWarning
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Dispatches a WriteWarning call to the specified trace target.</summary>
  /// <param name="target">The trace target to which the call will be dispatched.</param>
  /// <param name="text">The text to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static method DispatchWriteWarning(target: ITrace; text: String);
  begin
    var composite := target as CompositeTrace;
    if composite <> nil then
    begin
      composite.WriteWarning(text);
      return;
    end;

    var console := target as ConsoleTrace;
    if console <> nil then
    begin
      console.WriteWarning(text);
      return;
    end;

    var file := target as FileTrace;
    if file <> nil then
    begin
      file.WriteWarning(text);
      return;
    end;

    var none := target as NullTrace;
    if none <> nil then
    begin
      none.WriteWarning(text);
      return;
    end;

    target.WriteWarning(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • DispatchWriteError
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Dispatches a WriteError call to the specified trace target.</summary>
  /// <param name="target">The trace target to which the call will be dispatched.</param>
  /// <param name="text">The text to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static method DispatchWriteError(target: ITrace; text: String);
  begin
    var composite := target as CompositeTrace;
    if composite <> nil then
    begin
      composite.WriteError(text);
      return;
    end;

    var console := target as ConsoleTrace;
    if console <> nil then
    begin
      console.WriteError(text);
      return;
    end;

    var file := target as FileTrace;
    if file <> nil then
    begin
      file.WriteError(text);
      return;
    end;

    var none := target as NullTrace;
    if none <> nil then
    begin
      none.WriteError(text);
      return;
    end;

    target.WriteError(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • DispatchWriteErrorWithStackTrace
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Dispatches a WriteErrorWithStackTrace call to the specified trace target.</summary>
  /// <param name="target">The trace target to which the call will be dispatched.</param>
  /// <param name="text">The text to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static method DispatchWriteErrorWithStackTrace(target: ITrace; text: String);
  begin
    var composite := target as CompositeTrace;
    if composite <> nil then
    begin
      composite.WriteErrorWithStackTrace(text);
      return;
    end;

    var console := target as ConsoleTrace;
    if console <> nil then
    begin
      console.WriteErrorWithStackTrace(text);
      return;
    end;

    var file := target as FileTrace;
    if file <> nil then
    begin
      file.WriteErrorWithStackTrace(text);
      return;
    end;

    var none := target as NullTrace;
    if none <> nil then
    begin
      none.WriteErrorWithStackTrace(text);
      return;
    end;

    target.WriteErrorWithStackTrace(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Write
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the default information level to all configured trace targets.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Write(text: String);
  begin
    for each var entry in EntryList do
    begin
      DispatchWrite(entry, text);
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the default information level including a newline to all configured trace targets.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteLine(text: String);
  begin
    for each var entry in EntryList do
    begin
      DispatchWriteLine(entry, text);
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteDebug
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the debug level to all configured trace targets.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteDebug(text: String);
  begin
    for each var entry in EntryList do
    begin
      DispatchWriteDebug(entry, text);
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteInformation
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the information level to all configured trace targets.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteInformation(text: String);
  begin
    for each var entry in EntryList do
    begin
      DispatchWriteInformation(entry, text);
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteWarning
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the warning level to all configured trace targets.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteWarning(text: String);
  begin
    for each var entry in EntryList do
    begin
      DispatchWriteWarning(entry, text);
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteError
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the error level to all configured trace targets.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteError(text: String);
  begin
    for each var entry in EntryList do
    begin
      DispatchWriteError(entry, text);
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteErrorWithStackTrace
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the error level and stack trace to all configured trace targets.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method WriteErrorWithStackTrace(text: String);
  begin
    for each var entry in EntryList do
    begin
      DispatchWriteErrorWithStackTrace(entry, text);
    end;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Trace
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Provides the static diagnostics facade used by application and fixture code.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Trace
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Holds the current trace instance.</summary>
  private static var CurrentTrace: ITrace;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the current trace instance.</summary>
  public static property Current: ITrace
  begin
    get
    begin
      if CurrentTrace = nil then
      begin
        CurrentTrace := new ConsoleTrace();
      end;

      return CurrentTrace;
    end;

    set(value)
    begin
      CurrentTrace := value;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FUNCTION • CurrentAsComposite
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the current trace instance cast to CompositeTrace if possible, or null otherwise.</summary>
  /// <returns>The current trace instance cast to CompositeTrace if possible, or null otherwise.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static function CurrentAsComposite: CompositeTrace;
  begin
    return Current as CompositeTrace;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FUNCTION • CurrentAsConsole
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the current trace instance cast to ConsoleTrace if possible, or null otherwise.</summary>
  /// <returns>The current trace instance cast to ConsoleTrace if possible, or null otherwise.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————  
  private static function CurrentAsConsole: ConsoleTrace;
  begin
    return Current as ConsoleTrace;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FUNCTION • CurrentAsFile
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the current trace instance cast to FileTrace if possible, or null otherwise.</summary>
  /// <returns>The current trace instance cast to FileTrace if possible, or null otherwise.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static function CurrentAsFile: FileTrace;
  begin
    return Current as FileTrace;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FUNCTION • CurrentAsNull
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the current trace instance cast to NullTrace if possible, or null otherwise.</summary>
  /// <returns>The current trace instance cast to NullTrace if possible, or null otherwise.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  private static function CurrentAsNull: NullTrace;
  begin
    return Current as NullTrace;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Write
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the default information level to the current trace instance.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static method Write(text: String);
  begin
    var composite := CurrentAsComposite();
    if composite <> nil then
    begin
      composite.Write(text);
      return;
    end;

    var console := CurrentAsConsole();
    if console <> nil then
    begin
      console.Write(text);
      return;
    end;

    var file := CurrentAsFile();
    if file <> nil then
    begin
      file.Write(text);
      return;
    end;

    var none := CurrentAsNull();
    if none <> nil then
    begin
      none.Write(text);
      return;
    end;

    Current.Write(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteLine
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a trace message with the default information level including a newline to the current trace instance.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static method WriteLine(text: String);
  begin
    var composite := CurrentAsComposite();
    if composite <> nil then
    begin
      composite.WriteLine(text);
      return;
    end;

    var console := CurrentAsConsole();
    if console <> nil then
    begin
      console.WriteLine(text);
      return;
    end;

    var file := CurrentAsFile();
    if file <> nil then
    begin
      file.WriteLine(text);
      return;
    end;

    var none := CurrentAsNull();
    if none <> nil then
    begin
      none.WriteLine(text);
      return;
    end;

    Current.WriteLine(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteDebug
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a debug trace message to the current trace instance.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static method WriteDebug(text: String);
  begin
    var composite := CurrentAsComposite();
    if composite <> nil then
    begin
      composite.WriteDebug(text);
      return;
    end;

    var console := CurrentAsConsole();
    if console <> nil then
    begin
      console.WriteDebug(text);
      return;
    end;

    var file := CurrentAsFile();
    if file <> nil then
    begin
      file.WriteDebug(text);
      return;
    end;

    var none := CurrentAsNull();
    if none <> nil then
    begin
      none.WriteDebug(text);
      return;
    end;

    Current.WriteDebug(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteInformation
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes an information trace message to the current trace instance.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static method WriteInformation(text: String);
  begin
    var composite := CurrentAsComposite();
    if composite <> nil then
    begin
      composite.WriteInformation(text);
      return;
    end;

    var console := CurrentAsConsole();
    if console <> nil then
    begin
      console.WriteInformation(text);
      return;
    end;

    var file := CurrentAsFile();
    if file <> nil then
    begin
      file.WriteInformation(text);
      return;
    end;

    var none := CurrentAsNull();
    if none <> nil then
    begin
      none.WriteInformation(text);
      return;
    end;

    Current.WriteInformation(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteWarning
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes a warning trace message to the current trace instance.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static method WriteWarning(text: String);
  begin
    var composite := CurrentAsComposite();
    if composite <> nil then
    begin
      composite.WriteWarning(text);
      return;
    end;

    var console := CurrentAsConsole();
    if console <> nil then
    begin
      console.WriteWarning(text);
      return;
    end;

    var file := CurrentAsFile();
    if file <> nil then
    begin
      file.WriteWarning(text);
      return;
    end;

    var none := CurrentAsNull();
    if none <> nil then
    begin
      none.WriteWarning(text);
      return;
    end;

    Current.WriteWarning(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteError
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes an error trace message to the current trace instance.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static method WriteError(text: String);
  begin
    var composite := CurrentAsComposite();
    if composite <> nil then
    begin
      composite.WriteError(text);
      return;
    end;

    var console := CurrentAsConsole();
    if console <> nil then
    begin
      console.WriteError(text);
      return;
    end;

    var file := CurrentAsFile();
    if file <> nil then
    begin
      file.WriteError(text);
      return;
    end;

    var none := CurrentAsNull();
    if none <> nil then
    begin
      none.WriteError(text);
      return;
    end;

    Current.WriteError(text);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • WriteErrorWithStackTrace
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Writes an error trace message with stack trace to the current trace instance.</summary>
  /// <param name="text">The message to write.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static method WriteErrorWithStackTrace(text: String);
  begin
    var composite := CurrentAsComposite();
    if composite <> nil then
    begin
      composite.WriteErrorWithStackTrace(text);
      return;
    end;

    var console := CurrentAsConsole();
    if console <> nil then
    begin
      console.WriteErrorWithStackTrace(text);
      return;
    end;

    var file := CurrentAsFile();
    if file <> nil then
    begin
      file.WriteErrorWithStackTrace(text);
      return;
    end;

    var none := CurrentAsNull();
    if none <> nil then
    begin
      none.WriteErrorWithStackTrace(text);
      return;
    end;

    Current.WriteErrorWithStackTrace(text);
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══ end of file ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
