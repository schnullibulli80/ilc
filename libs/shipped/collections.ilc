  private var HeadValue: T;

  public constructor(source: IEnumerable<T>; value: T);
  begin
    SourceValue := source;
    HeadValue := value;
  end;

  public function GetEnumerator(): IEnumerator<T>;
  begin
    return new PrependEnumerator<T>(SourceValue.GetEnumerator(), HeadValue);
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • ReverseEnumerator<T>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Enumerates a buffered source in reverse order.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class ReverseEnumerator<T>: IEnumerator<T>
begin
  private var Buffer: List<T>;
  private var Index: Integer;
  private var CurrentValue: T;

  public property Current: T
  begin
    get
    begin
      return CurrentValue;
    end;
  end;

  public constructor(source: IEnumerable<T>);
  begin
    Buffer := new List<T>();
    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      Buffer.Add(enumerator.Current);
    end;
    Index := Buffer.Count;
  end;

  public function MoveNext(): Boolean;
  begin
    if Index <= 0 then
    begin
      return false;
    end;

    Index := Index - 1;
    CurrentValue := Buffer[Index];
    return true;
  end;

  public method Reset;
  begin
    Index := Buffer.Count;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
