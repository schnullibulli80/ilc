//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class AppendEnumerable<T>: IEnumerable<T>
begin
  private var SourceValue: IEnumerable<T>;
  private var TailValue: T;

  public constructor(source: IEnumerable<T>; value: T);
  begin
    SourceValue := source;
    TailValue := value;
  end;

  public function GetEnumerator(): IEnumerator<T>;
  begin
    return new AppendEnumerator<T>(SourceValue.GetEnumerator(), TailValue);
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • PrependEnumerator<T>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Enumerates one leading value before a source.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class PrependEnumerator<T>: IEnumerator<T>
begin
  private var SourceEnumerator: IEnumerator<T>;
  private var HeadValue: T;
  private var HeadAvailable: Boolean;
  private var EmittingHead: Boolean;

  public property Current: T
  begin
    get
    begin
      if EmittingHead then
      begin
        return HeadValue;
      end;

      return SourceEnumerator.Current;
    end;
  end;

  public constructor(sourceEnumerator: IEnumerator<T>; value: T);
  begin
    SourceEnumerator := sourceEnumerator;
    HeadValue := value;
    HeadAvailable := true;
    EmittingHead := false;
  end;

  public function MoveNext(): Boolean;
  begin
    if HeadAvailable then
    begin
      HeadAvailable := false;
      EmittingHead := true;
      return true;
    end;

    EmittingHead := false;
    return SourceEnumerator.MoveNext();
  end;

  public method Reset;
  begin
    SourceEnumerator.Reset();
    HeadAvailable := true;
    EmittingHead := false;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • PrependEnumerable<T>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
