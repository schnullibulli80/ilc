//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class ReverseEnumerable<T>: IEnumerable<T>
begin
  private var SourceValue: IEnumerable<T>;

  public constructor(source: IEnumerable<T>);
  begin
    SourceValue := source;
  end;

  public function GetEnumerator(): IEnumerator<T>;
  begin
    return new ReverseEnumerator<T>(SourceValue);
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Enumerable<T>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Provides the first shipped enumerable pipeline helpers for filtering.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Enumerable<T>
begin
  public static function Where(source: IEnumerable<T>; predicate: Predicate<T>): IEnumerable<T>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if predicate = nil then
    begin
      raise new Exception('Enumerable predicate must not be nil.');
    end;

    return new WhereEnumerable<T>(source, predicate);
  end;

  public static function Take(source: IEnumerable<T>; count: Integer): IEnumerable<T>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if count <= 0 then
    begin
      count := 0;
    end;

    return new TakeEnumerable<T>(source, count);
  end;

  public static function Skip(source: IEnumerable<T>; count: Integer): IEnumerable<T>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if count <= 0 then
    begin
      count := 0;
    end;

    return new SkipEnumerable<T>(source, count);
  end;

  public static function Concat(first: IEnumerable<T>; second: IEnumerable<T>): IEnumerable<T>;
  begin
    if first = nil then
    begin
      raise new Exception('Enumerable first source must not be nil.');
    end;

    if second = nil then
    begin
      raise new Exception('Enumerable second source must not be nil.');
    end;

    return new ConcatEnumerable<T>(first, second);
  end;

  public static function Distinct(source: IEnumerable<T>): IEnumerable<T>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    return new DistinctEnumerable<T>(source);
  end;

  public static function Append(source: IEnumerable<T>; value: T): IEnumerable<T>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    return new AppendEnumerable<T>(source, value);
  end;

  public static function Prepend(source: IEnumerable<T>; value: T): IEnumerable<T>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    return new PrependEnumerable<T>(source, value);
  end;

  public static function Reverse(source: IEnumerable<T>): IEnumerable<T>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    return new ReverseEnumerable<T>(source);
  end;

  public static function OrderBy(source: IEnumerable<T>; selector: Selector<T, Integer>): IEnumerable<T>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if selector = nil then
    begin
      raise new Exception('Enumerable selector must not be nil.');
    end;

    var result := ToList(source);
    var index := 1;
    while index < result.Count do
    begin
      var currentItem := result[index];
      var currentKey := selector(currentItem);
      var insertIndex := index - 1;
      while insertIndex >= 0 do
      begin
        if selector(result[insertIndex]) <= currentKey then
        begin
          break;
        end;

        result[insertIndex + 1] := result[insertIndex];
        insertIndex := insertIndex - 1;
      end;

      result[insertIndex + 1] := currentItem;
      index := index + 1;
    end;

    return result;
  end;

  public static function OrderByDescending(source: IEnumerable<T>; selector: Selector<T, Integer>): IEnumerable<T>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if selector = nil then
    begin
      raise new Exception('Enumerable selector must not be nil.');
    end;

    var result := ToList(source);
    var index := 1;
    while index < result.Count do
    begin
      var currentItem := result[index];
      var currentKey := selector(currentItem);
      var insertIndex := index - 1;
      while insertIndex >= 0 do
      begin
        if selector(result[insertIndex]) >= currentKey then
        begin
          break;
        end;

        result[insertIndex + 1] := result[insertIndex];
        insertIndex := insertIndex - 1;
      end;

      result[insertIndex + 1] := currentItem;
      index := index + 1;
    end;

    return result;
  end;

  public static function Contains(source: IEnumerable<T>; value: T): Boolean;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      if enumerator.Current = value then
      begin
        return true;
      end;
    end;

    return false;
  end;

  public static function Any(source: IEnumerable<T>): Boolean;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    var enumerator := source.GetEnumerator();
    return enumerator.MoveNext();
  end;

  public static function Any(source: IEnumerable<T>; predicate: Predicate<T>): Boolean;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if predicate = nil then
    begin
      raise new Exception('Enumerable predicate must not be nil.');
    end;

    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      if predicate(enumerator.Current) then
      begin
        return true;
      end;
    end;

    return false;
  end;

  public static function Count(source: IEnumerable<T>): Integer;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    var enumerator := source.GetEnumerator();
    var count := 0;
    while enumerator.MoveNext() do
    begin
      count := count + 1;
    end;

    return count;
  end;

  public static function Count(source: IEnumerable<T>; predicate: Predicate<T>): Integer;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if predicate = nil then
    begin
      raise new Exception('Enumerable predicate must not be nil.');
    end;

    var enumerator := source.GetEnumerator();
    var count := 0;
    while enumerator.MoveNext() do
    begin
      if predicate(enumerator.Current) then
      begin
        count := count + 1;
      end;
    end;

    return count;
  end;

  public static function FirstOrDefault(source: IEnumerable<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    var fallback: T;
    var enumerator := source.GetEnumerator();
    if enumerator.MoveNext() then
    begin
      return enumerator.Current;
    end;

    return fallback;
  end;

  public static function First(source: IEnumerable<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    var enumerator := source.GetEnumerator();
    if enumerator.MoveNext() then
    begin
      return enumerator.Current;
    end;

    raise new Exception('Enumerable sequence contains no elements.');
  end;

  public static function FirstOrDefault(source: IEnumerable<T>; predicate: Predicate<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if predicate = nil then
    begin
      raise new Exception('Enumerable predicate must not be nil.');
    end;

    var fallback: T;
    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      if predicate(enumerator.Current) then
      begin
        return enumerator.Current;
      end;
    end;

    return fallback;
  end;

  public static function First(source: IEnumerable<T>; predicate: Predicate<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if predicate = nil then
    begin
      raise new Exception('Enumerable predicate must not be nil.');
    end;

    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      if predicate(enumerator.Current) then
      begin
        return enumerator.Current;
      end;
    end;

    raise new Exception('Enumerable sequence contains no matching element.');
  end;

  public static function SingleOrDefault(source: IEnumerable<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    var fallback: T;
    var enumerator := source.GetEnumerator();
    if not enumerator.MoveNext() then
    begin
      return fallback;
    end;

    var result := enumerator.Current;
    if enumerator.MoveNext() then
    begin
      raise new Exception('Enumerable sequence contains more than one element.');
    end;

    return result;
  end;

  public static function Single(source: IEnumerable<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    var enumerator := source.GetEnumerator();
    if not enumerator.MoveNext() then
    begin
      raise new Exception('Enumerable sequence contains no elements.');
    end;

    var result := enumerator.Current;
    if enumerator.MoveNext() then
    begin
      raise new Exception('Enumerable sequence contains more than one element.');
    end;

    return result;
  end;

  public static function SingleOrDefault(source: IEnumerable<T>; predicate: Predicate<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if predicate = nil then
    begin
      raise new Exception('Enumerable predicate must not be nil.');
    end;

    var fallback: T;
    var hasResult := false;
    var result := fallback;
    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      if predicate(enumerator.Current) then
      begin
        if hasResult then
        begin
          raise new Exception('Enumerable sequence contains more than one matching element.');
        end;

        hasResult := true;
        result := enumerator.Current;
      end;
    end;

    return result;
  end;

  public static function Single(source: IEnumerable<T>; predicate: Predicate<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if predicate = nil then
    begin
      raise new Exception('Enumerable predicate must not be nil.');
    end;

    var fallback: T;
    var hasResult := false;
    var result := fallback;
    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      if predicate(enumerator.Current) then
      begin
        if hasResult then
        begin
          raise new Exception('Enumerable sequence contains more than one matching element.');
        end;

        hasResult := true;
        result := enumerator.Current;
      end;
    end;

    if hasResult then
    begin
      return result;
    end;

    raise new Exception('Enumerable sequence contains no matching element.');
  end;

  public static function LastOrDefault(source: IEnumerable<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    var fallback: T;
    var result := fallback;
    var hasResult := false;
    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      hasResult := true;
      result := enumerator.Current;
    end;

    return result;
  end;

  public static function Last(source: IEnumerable<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    var enumerator := source.GetEnumerator();
    if not enumerator.MoveNext() then
    begin
      raise new Exception('Enumerable sequence contains no elements.');
    end;

    var result := enumerator.Current;
    while enumerator.MoveNext() do
    begin
      result := enumerator.Current;
    end;

    return result;
  end;

  public static function LastOrDefault(source: IEnumerable<T>; predicate: Predicate<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if predicate = nil then
    begin
      raise new Exception('Enumerable predicate must not be nil.');
    end;

    var fallback: T;
    var result := fallback;
    var hasResult := false;
    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      if predicate(enumerator.Current) then
      begin
        hasResult := true;
        result := enumerator.Current;
      end;
    end;

    return result;
  end;

  public static function Last(source: IEnumerable<T>; predicate: Predicate<T>): T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if predicate = nil then
    begin
      raise new Exception('Enumerable predicate must not be nil.');
    end;

    var fallback: T;
    var result := fallback;
    var hasResult := false;
    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      if predicate(enumerator.Current) then
      begin
        hasResult := true;
        result := enumerator.Current;
      end;
    end;

    if hasResult then
    begin
      return result;
    end;

    raise new Exception('Enumerable sequence contains no matching element.');
  end;

  public static function ToList(source: IEnumerable<T>): List<T>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    var result := new List<T>();
    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      result.Add(enumerator.Current);
    end;

    return result;
  end;

  public static function ToArray(source: IEnumerable<T>): array of T;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    return ToList(source).ToArray();
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Enumerable<TSource, TResult>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Provides the first shipped enumerable pipeline helpers for projections.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Enumerable<TSource, TResult>
begin
  public static function Select(source: IEnumerable<TSource>; selector: Selector<TSource, TResult>): IEnumerable<TResult>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if selector = nil then
    begin
      raise new Exception('Enumerable selector must not be nil.');
    end;

    return new SelectEnumerable<TSource, TResult>(source, selector);
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Enumerable<TFirst, TSecond, TThird>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Enumerable<TFirst, TSecond, TThird>
begin
  public static function SelectMany(source: IEnumerable<TFirst>; collectionSelector: CollectionSelector<TFirst, TSecond>; resultSelector: ResultSelector<TFirst, TSecond, TThird>): IEnumerable<TThird>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if collectionSelector = nil then
    begin
      raise new Exception('Enumerable collection selector must not be nil.');
    end;

    if resultSelector = nil then
    begin
      raise new Exception('Enumerable result selector must not be nil.');
    end;

    var result := new List<TThird>();
    var outerEnumerator := source.GetEnumerator();
    while outerEnumerator.MoveNext() do
    begin
      var outerValue := outerEnumerator.Current;
      var innerSource := collectionSelector(outerValue);
      if innerSource = nil then
      begin
        raise new Exception('Enumerable collection selector must not return nil.');
      end;

      var innerEnumerator := innerSource.GetEnumerator();
      while innerEnumerator.MoveNext() do
      begin
        result.Add(resultSelector(outerValue, innerEnumerator.Current));
      end;
    end;

    return result;
  end;

  public static function GroupBy(source: IEnumerable<TFirst>; keySelector: Selector<TFirst, Integer>; elementSelector: Selector<TFirst, TThird>): IEnumerable<Grouping<Integer, TThird>>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if keySelector = nil then
    begin
      raise new Exception('Enumerable key selector must not be nil.');
    end;

    if elementSelector = nil then
    begin
      raise new Exception('Enumerable element selector must not be nil.');
    end;

    var result := new List<Grouping<Integer, TThird>>();
    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      var sourceValue := enumerator.Current;
      var key := keySelector(sourceValue);
      var found := false;
      var index := 0;
      while index < result.Count do
      begin
        if result[index].Key = key then
        begin
          result[index].Add(elementSelector(sourceValue));
          found := true;
          break;
        end;

        index := index + 1;
      end;

      if not found then
      begin
        var grouping := new Grouping<Integer, TThird>(key);
        grouping.Add(elementSelector(sourceValue));
        result.Add(grouping);
      end;
    end;

    return result;
  end;

  public static function GroupBy(source: IEnumerable<TFirst>; keySelector: Selector<TFirst, String>; elementSelector: Selector<TFirst, TThird>): IEnumerable<Grouping<String, TThird>>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if keySelector = nil then
    begin
      raise new Exception('Enumerable key selector must not be nil.');
    end;

    if elementSelector = nil then
    begin
      raise new Exception('Enumerable element selector must not be nil.');
    end;

    var result := new List<Grouping<String, TThird>>();
    var enumerator := source.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      var sourceValue := enumerator.Current;
      var key := keySelector(sourceValue);
      var found := false;
      var index := 0;
      while index < result.Count do
      begin
        if result[index].Key = key then
        begin
          result[index].Add(elementSelector(sourceValue));
          found := true;
          break;
        end;

        index := index + 1;
      end;

      if not found then
      begin
        var grouping := new Grouping<String, TThird>(key);
        grouping.Add(elementSelector(sourceValue));
        result.Add(grouping);
      end;
    end;

    return result;
  end;

  public static function GroupJoin(source: IEnumerable<TFirst>; inner: IEnumerable<TSecond>; outerKeySelector: Selector<TFirst, Integer>; innerKeySelector: Selector<TSecond, Integer>; resultSelector: GroupResultSelector<TFirst, TSecond, TThird>): IEnumerable<TThird>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if inner = nil then
    begin
      raise new Exception('Enumerable inner source must not be nil.');
    end;

    if outerKeySelector = nil then
    begin
      raise new Exception('Enumerable outer key selector must not be nil.');
    end;

    if innerKeySelector = nil then
    begin
      raise new Exception('Enumerable inner key selector must not be nil.');
    end;

    if resultSelector = nil then
    begin
      raise new Exception('Enumerable group result selector must not be nil.');
    end;

    var result := new List<TThird>();
    var outerEnumerator := source.GetEnumerator();
    while outerEnumerator.MoveNext() do
    begin
      var outerValue := outerEnumerator.Current;
      var outerKey := outerKeySelector(outerValue);
      var group := new List<TSecond>();
      var innerEnumerator := inner.GetEnumerator();
      while innerEnumerator.MoveNext() do
      begin
        var innerValue := innerEnumerator.Current;
        if outerKey = innerKeySelector(innerValue) then
        begin
          group.Add(innerValue);
        end;
      end;

      result.Add(resultSelector(outerValue, group));
    end;

    return result;
  end;

  public static function GroupJoin(source: IEnumerable<TFirst>; inner: IEnumerable<TSecond>; outerKeySelector: Selector<TFirst, String>; innerKeySelector: Selector<TSecond, String>; resultSelector: GroupResultSelector<TFirst, TSecond, TThird>): IEnumerable<TThird>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if inner = nil then
    begin
      raise new Exception('Enumerable inner source must not be nil.');
    end;

    if outerKeySelector = nil then
    begin
      raise new Exception('Enumerable outer key selector must not be nil.');
    end;

    if innerKeySelector = nil then
    begin
      raise new Exception('Enumerable inner key selector must not be nil.');
    end;

    if resultSelector = nil then
    begin
      raise new Exception('Enumerable group result selector must not be nil.');
    end;

    var result := new List<TThird>();
    var outerEnumerator := source.GetEnumerator();
    while outerEnumerator.MoveNext() do
    begin
      var outerValue := outerEnumerator.Current;
      var outerKey := outerKeySelector(outerValue);
      var group := new List<TSecond>();
      var innerEnumerator := inner.GetEnumerator();
      while innerEnumerator.MoveNext() do
      begin
        var innerValue := innerEnumerator.Current;
        if outerKey = innerKeySelector(innerValue) then
        begin
          group.Add(innerValue);
        end;
      end;

      result.Add(resultSelector(outerValue, group));
    end;

    return result;
  end;

  public static function Join(source: IEnumerable<TFirst>; inner: IEnumerable<TSecond>; outerKeySelector: Selector<TFirst, Integer>; innerKeySelector: Selector<TSecond, Integer>; resultSelector: ResultSelector<TFirst, TSecond, TThird>): IEnumerable<TThird>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if inner = nil then
    begin
      raise new Exception('Enumerable inner source must not be nil.');
    end;

    if outerKeySelector = nil then
    begin
      raise new Exception('Enumerable outer key selector must not be nil.');
    end;

    if innerKeySelector = nil then
    begin
      raise new Exception('Enumerable inner key selector must not be nil.');
    end;

    if resultSelector = nil then
    begin
      raise new Exception('Enumerable result selector must not be nil.');
    end;

    var result := new List<TThird>();
    var outerEnumerator := source.GetEnumerator();
    while outerEnumerator.MoveNext() do
    begin
      var outerValue := outerEnumerator.Current;
      var outerKey := outerKeySelector(outerValue);
      var innerEnumerator := inner.GetEnumerator();
      while innerEnumerator.MoveNext() do
      begin
        var innerValue := innerEnumerator.Current;
        if outerKey = innerKeySelector(innerValue) then
        begin
          result.Add(resultSelector(outerValue, innerValue));
        end;
      end;
    end;

    return result;
  end;

  public static function Join(source: IEnumerable<TFirst>; inner: IEnumerable<TSecond>; outerKeySelector: Selector<TFirst, String>; innerKeySelector: Selector<TSecond, String>; resultSelector: ResultSelector<TFirst, TSecond, TThird>): IEnumerable<TThird>;
  begin
    if source = nil then
    begin
      raise new Exception('Enumerable source must not be nil.');
    end;

    if inner = nil then
    begin
      raise new Exception('Enumerable inner source must not be nil.');
    end;

    if outerKeySelector = nil then
    begin
      raise new Exception('Enumerable outer key selector must not be nil.');
    end;

    if innerKeySelector = nil then
    begin
      raise new Exception('Enumerable inner key selector must not be nil.');
    end;

    if resultSelector = nil then
    begin
      raise new Exception('Enumerable result selector must not be nil.');
    end;

    var result := new List<TThird>();
    var outerEnumerator := source.GetEnumerator();
    while outerEnumerator.MoveNext() do
    begin
      var outerValue := outerEnumerator.Current;
      var outerKey := outerKeySelector(outerValue);
      var innerEnumerator := inner.GetEnumerator();
      while innerEnumerator.MoveNext() do
      begin
        var innerValue := innerEnumerator.Current;
        if outerKey = innerKeySelector(innerValue) then
        begin
          result.Add(resultSelector(outerValue, innerValue));
        end;
      end;
    end;

    return result;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • StringList
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Provides a convenience compatibility alias for List&lt;String&gt;.</summary>
