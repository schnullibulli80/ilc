  public static extern procedure DestroyWindow(windowHandle: NativeHandle);

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_set_root_name', CallingConvention := CallingConvention.Cdecl)]
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • EXTERNAL • SetRootName
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Sets the root name of the specified window.</summary>
  /// <param name="windowHandle">The native handle of the window.</param>
  /// <param name="rootName">The root name to set.</param>
  /// <returns>An integer Result indicating success or failure.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static extern function SetRootName(windowHandle: NativeHandle; rootName: String): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_set_content_qml', CallingConvention := CallingConvention.Cdecl)]
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • EXTERNAL • SetContentQml
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Sets the QML content of the specified window.</summary>
  /// <param name="windowHandle">The native handle of the window.</param>
  /// <param name="qmlSource">The QML source to set as the content.</param>
  /// <returns>An integer Result indicating success or failure.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public static extern function SetContentQml(windowHandle: NativeHandle; qmlSource: String): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_set_element_text', CallingConvention := CallingConvention.Cdecl)]
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • EXTERNAL • SetElementText
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Sets the text of a specific element in the specified window.</summary>
  /// <param name="windowHandle">The native handle of the window.</param>
  /// <param name="objectName">The name of the element.</param>
