namespace System.Ui.Backends.QtQuick;

uses System, System.Collections, System.Ui, System.Ui.Hosting;

public enum StringReturn
begin
  None = 0;
  Utf8Owned = 1;
end;

public delegate function QtQuickInteractionCallback(interactionToken: Integer): Integer;

public enum QtQuickRenderMode
begin
  ManagedPreview = 0;
  NativeBridge = 1;
end;

public class QtQuickNative
begin
  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_backend_create', CallingConvention := CallingConvention.Cdecl)]
  public static extern function CreateBackend(): NativeHandle;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_backend_destroy', CallingConvention := CallingConvention.Cdecl)]
  public static extern procedure DestroyBackend(handle: NativeHandle);

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_create', CallingConvention := CallingConvention.Cdecl)]
  public static extern function CreateWindow(backendHandle: NativeHandle; title: String): NativeHandle;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_show', CallingConvention := CallingConvention.Cdecl)]
  public static extern function ShowWindow(windowHandle: NativeHandle): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_set_size', CallingConvention := CallingConvention.Cdecl)]
  public static extern function SetWindowSize(windowHandle: NativeHandle; width: Integer; height: Integer): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_set_minimum_size', CallingConvention := CallingConvention.Cdecl)]
  public static extern function SetWindowMinimumSize(windowHandle: NativeHandle; minWidth: Integer; minHeight: Integer): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_set_background', CallingConvention := CallingConvention.Cdecl)]
  public static extern function SetWindowBackground(windowHandle: NativeHandle; color: String): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_destroy', CallingConvention := CallingConvention.Cdecl)]
  public static extern procedure DestroyWindow(windowHandle: NativeHandle);

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_set_root_name', CallingConvention := CallingConvention.Cdecl)]
  public static extern function SetRootName(windowHandle: NativeHandle; rootName: String): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_set_content_qml', CallingConvention := CallingConvention.Cdecl)]
  public static extern function SetContentQml(windowHandle: NativeHandle; qmlSource: String): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_set_element_text', CallingConvention := CallingConvention.Cdecl)]
  public static extern function SetElementText(windowHandle: NativeHandle; objectName: String; text: String): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_set_element_color', CallingConvention := CallingConvention.Cdecl)]
  public static extern function SetElementColor(windowHandle: NativeHandle; objectName: String; color: String): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_backend_run', CallingConvention := CallingConvention.Cdecl)]
  public static extern function RunBackend(backendHandle: NativeHandle): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_backend_run_with_click_callback', CallingConvention := CallingConvention.Cdecl)]
  public static extern function RunBackendWithClickCallback(backendHandle: NativeHandle; callback: QtQuickInteractionCallback): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_backend_read_text_input_value', CallingConvention := CallingConvention.Cdecl, StringReturn := StringReturn.Utf8Owned, StringFreeEntryPoint := 'ilc_qtquick_string_free')]
  public static extern function ReadTextInputValue(backendHandle: NativeHandle; textBoxId: Integer): String;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_backend_read_slider_value', CallingConvention := CallingConvention.Cdecl)]
  public static extern function ReadSliderValue(backendHandle: NativeHandle; sliderId: Integer): Integer;

  [DllImport('libilc_qtbridge.so', EntryPoint := 'ilc_qtquick_window_focus_text_input', CallingConvention := CallingConvention.Cdecl)]
  public static extern function FocusTextInput(windowHandle: NativeHandle; textBoxId: Integer): Integer;
end;

public class QtQuickNativeViewHost: IViewHost
begin
  private var ViewValue: View;
  private var NativeViewHandleValue: NativeHandle;

  public property View: View
  begin
    get
    begin
      return ViewValue;
    end;
  end;

  public property NativeViewHandle: NativeHandle
  begin
    get
    begin
      return NativeViewHandleValue;
    end;
  end;

  public property HasNativeViewHandle: Boolean
  begin
    get
    begin
      return NativeViewHandleValue <> NativeHandle.Null;
    end;
  end;

  public constructor(view: View; nativeViewHandle: NativeHandle);
  begin
    ViewValue := view;
    NativeViewHandleValue := nativeViewHandle;
  end;

  public function Describe: String;
  begin
    if ViewValue = nil then
    begin
      return 'nil';
    end;

    if ViewValue.Name <> '' then
    begin
      return ViewValue.Name;
    end;

    return 'view';
  end;
end;

public class QtQuickNativeWindowHost: IWindowHost
begin
  private var WindowValue: Window;
  private var RootViewHostValue: IViewHost;
  private var NativeWindowHandleValue: NativeHandle;

  public property Window: Window
  begin
    get
    begin
      return WindowValue;
    end;
  end;

  public property RootViewHost: IViewHost
  begin
    get
    begin
      return RootViewHostValue;
    end;
  end;

  public property NativeWindowHandle: NativeHandle
  begin
    get
    begin
      return NativeWindowHandleValue;
    end;
  end;

  public property HasNativeWindowHandle: Boolean
  begin
    get
    begin
      return NativeWindowHandleValue <> NativeHandle.Null;
    end;
  end;

  public constructor(window: Window; nativeWindowHandle: NativeHandle);
  begin
    WindowValue := window;
    NativeWindowHandleValue := nativeWindowHandle;
    if window = nil or window.Content = nil then
    begin
      RootViewHostValue := nil;
    end
    else
    begin
      var contentView := window.Content;
      RootViewHostValue := new QtQuickNativeViewHost(contentView, NativeHandle.Null);
    end;
  end;

  public function Show: Boolean;
  begin
    if WindowValue = nil then
    begin
      return false;
    end;

    return true;
  end;
end;

public class QtQuickBackend: IUiBackend
begin
  public static var CurrentInteractiveBackend: QtQuickBackend;

  private var FallbackBackendValue: IUiBackend;
  private var EngineInitializedValue: Boolean;
  private var NativeBridgeEnabledValue: Boolean;
  private var NativeBackendHandleValue: NativeHandle;
  private var LastInteractiveWindowHandleValue: NativeHandle;
  private var LastHostedWindowTitleValue: String;
  private var LastHostedRootDescriptionValue: String;
  private var LastBridgeStatusValue: String;
  private var ActiveButtonsValue: List<Button>;
  private var ActiveCheckBoxesValue: List<CheckBox>;
  private var ActiveTextBoxesValue: List<TextBox>;
  private var ActiveSlidersValue: List<Slider>;
  private var ActiveInteractiveWindowsValue: List<Window>;
  private var ActiveInteractiveWindowHandlesValue: List<NativeHandle>;
  private var PendingFocusTextBoxValue: TextBox;

  public property BackendName: String
  begin
    get
    begin
      return 'QtQuick';
    end;
  end;

  public property RenderMode: QtQuickRenderMode
  begin
    get
    begin
      if NativeBridgeEnabledValue then
      begin
        return QtQuickRenderMode.NativeBridge;
      end;

      return QtQuickRenderMode.ManagedPreview;
    end;
  end;

  public property IsAvailable: Boolean
  begin
    get
    begin
      return EngineInitializedValue;
    end;
  end;

  public property LastHostedWindowTitle: String
  begin
    get
    begin
      return LastHostedWindowTitleValue;
    end;
  end;

  public property LastHostedRootDescription: String
  begin
    get
    begin
      return LastHostedRootDescriptionValue;
    end;
  end;

  public property NativeBackendHandle: NativeHandle
  begin
    get
    begin
      return NativeBackendHandleValue;
    end;
  end;

  public property HasNativeBackendHandle: Boolean
  begin
    get
    begin
      return NativeBackendHandleValue <> NativeHandle.Null;
    end;
  end;

  public property NativeBridgeEnabled: Boolean
  begin
    get
    begin
      return NativeBridgeEnabledValue;
    end;

    set(value)
    begin
      NativeBridgeEnabledValue := value;
    end;
  end;

  public property LastInteractiveWindowHandle: NativeHandle
  begin
    get
    begin
      return LastInteractiveWindowHandleValue;
    end;
  end;

  public property BridgeLibraryName: String
  begin
    get
    begin
      return 'libilc_qtbridge.so';
    end;
  end;

  public property LastBridgeStatus: String
  begin
    get
    begin
      return LastBridgeStatusValue;
    end;
  end;

  public constructor;
  begin
    FallbackBackendValue := new DebugUiBackend();
    EngineInitializedValue := false;
    NativeBridgeEnabledValue := false;
    NativeBackendHandleValue := NativeHandle.Null;
    LastInteractiveWindowHandleValue := NativeHandle.Null;
    LastHostedWindowTitleValue := '';
    LastHostedRootDescriptionValue := '';
    LastBridgeStatusValue := 'managed-fallback';
    ActiveButtonsValue := new List<Button>();
    ActiveCheckBoxesValue := new List<CheckBox>();
    ActiveTextBoxesValue := new List<TextBox>();
    ActiveSlidersValue := new List<Slider>();
    ActiveInteractiveWindowsValue := new List<Window>();
    ActiveInteractiveWindowHandlesValue := new List<NativeHandle>();
    PendingFocusTextBoxValue := nil;
  end;

  public function InitializeEngine: Boolean;
  begin
    EngineInitializedValue := true;
    if NativeBridgeEnabledValue then
    begin
      LastBridgeStatusValue := 'native-bridge-configured';
    end
    else
    begin
      LastBridgeStatusValue := 'managed-fallback';
    end;

    return EngineInitializedValue;
  end;

  public function CreateWindowHost(window: Window): IWindowHost;
  begin
    if window = nil then
    begin
      return nil;
    end;

    LastHostedWindowTitleValue := window.Title;
    if NativeBridgeEnabledValue then
    begin
      LastBridgeStatusValue := 'native-window-host-prepared';
      return new QtQuickNativeWindowHost(window, NativeHandle.Null);
    end;

    return FallbackBackendValue.CreateWindowHost(window);
  end;

  public function PrepareNativeBridge: Boolean;
  begin
    NativeBridgeEnabledValue := true;
    NativeBackendHandleValue := NativeHandle.Null;
    LastInteractiveWindowHandleValue := NativeHandle.Null;
    LastBridgeStatusValue := 'native-bridge-prepared';
    return true;
  end;

  private method ResetInteractiveSession;
  begin
    ActiveButtonsValue := new List<Button>();
    ActiveCheckBoxesValue := new List<CheckBox>();
    ActiveTextBoxesValue := new List<TextBox>();
    ActiveSlidersValue := new List<Slider>();
    ActiveInteractiveWindowsValue := new List<Window>();
    ActiveInteractiveWindowHandlesValue := new List<NativeHandle>();
    PendingFocusTextBoxValue := nil;
  end;

  private function RegisterInteractiveButton(button: Button): Integer;
  begin
    if button = nil then
    begin
      return 0;
    end;

    var index := 0;
    while index < ActiveButtonsValue.Count do
    begin
      if ActiveButtonsValue[index] = button then
      begin
        return index + 1;
      end;

      index := index + 1;
    end;

    ActiveButtonsValue.Add(button);
    return ActiveButtonsValue.Count;
  end;

  private function FindInteractiveButton(buttonId: Integer): Button;
  begin
    if buttonId <= 0 then
    begin
      return nil;
    end;

    var index := buttonId - 1;
    if index >= ActiveButtonsValue.Count then
    begin
      return nil;
    end;

    return ActiveButtonsValue[index];
  end;

  private function RegisterInteractiveCheckBox(checkBox: CheckBox): Integer;
  begin
    if checkBox = nil then
    begin
      return 0;
    end;

    var index := 0;
    while index < ActiveCheckBoxesValue.Count do
    begin
      if ActiveCheckBoxesValue[index] = checkBox then
      begin
        return index + 1;
      end;

      index := index + 1;
    end;

    ActiveCheckBoxesValue.Add(checkBox);
    return ActiveCheckBoxesValue.Count;
  end;

  private function FindInteractiveCheckBox(checkBoxId: Integer): CheckBox;
  begin
    if checkBoxId <= 0 then
    begin
      return nil;
    end;

    var index := checkBoxId - 1;
    if index >= ActiveCheckBoxesValue.Count then
    begin
      return nil;
    end;

    return ActiveCheckBoxesValue[index];
  end;

  private function RegisterInteractiveTextBox(textBox: TextBox): Integer;
  begin
    if textBox = nil then
    begin
      return 0;
    end;

    var index := 0;
    while index < ActiveTextBoxesValue.Count do
    begin
      if ActiveTextBoxesValue[index] = textBox then
      begin
        return index + 1;
      end;

      index := index + 1;
    end;

    ActiveTextBoxesValue.Add(textBox);
    return ActiveTextBoxesValue.Count;
  end;

  private function FindInteractiveTextBox(textBoxId: Integer): TextBox;
  begin
    if textBoxId <= 0 then
    begin
      return nil;
    end;

    var index := textBoxId - 1;
    if index >= ActiveTextBoxesValue.Count then
    begin
      return nil;
    end;

    return ActiveTextBoxesValue[index];
  end;

  private function RegisterInteractiveSlider(slider: Slider): Integer;
  begin
    if slider = nil then
    begin
      return 0;
    end;

    var index := 0;
    while index < ActiveSlidersValue.Count do
    begin
      if ActiveSlidersValue[index] = slider then
      begin
        return index + 1;
      end;

      index := index + 1;
    end;

    ActiveSlidersValue.Add(slider);
    return ActiveSlidersValue.Count;
  end;

  private function GetButtonLabelObjectName(button: Button): String;
  begin
    if button = nil then
    begin
      return '';
    end;

    if button.Name = nil then
    begin
      return '';
    end;

    if button.Name = '' then
    begin
      return '';
    end;

    return button.Name + '_label';
  end;

  private function HasPatchObjectName(name: String): Boolean;
  begin
    if name = nil then
    begin
      return false;
    end;

    return name <> '';
  end;

  private function IsBackendDebugEnabled: Boolean;
  begin
    return Environment.Variables['ILC_QTBRIDGE_DEBUG'] = '1';
  end;

  private method WriteBackendDebug(message: String);
  begin
    if IsBackendDebugEnabled() then
    begin
      Console.WriteLine('[ilc_qtquick/backend] ' + message);
    end;
  end;

  private function FindInteractiveSlider(sliderId: Integer): Slider;
  begin
    if sliderId <= 0 then
    begin
      return nil;
    end;

    var index := sliderId - 1;
    if index >= ActiveSlidersValue.Count then
    begin
      return nil;
    end;

    return ActiveSlidersValue[index];
  end;

  private function EncodeButtonInteraction(buttonId: Integer): Integer;
  begin
    return buttonId;
  end;

  private function EncodeTextBoxInteraction(textBoxId: Integer): Integer;
  begin
    return 0 - textBoxId;
  end;

  private function EncodeCheckBoxInteraction(checkBoxId: Integer): Integer;
  begin
    return 0 - (1000000 + checkBoxId);
  end;

  private function EncodeSliderInteraction(sliderId: Integer): Integer;
  begin
    return 0 - (2000000 + sliderId);
  end;

  private method TrackInteractiveWindow(window: Window; windowHandle: NativeHandle);
  begin
    if window = nil or windowHandle = NativeHandle.Null then
    begin
      return;
    end;

    ActiveInteractiveWindowsValue.Add(window);
    ActiveInteractiveWindowHandlesValue.Add(windowHandle);
  end;

  private function RefreshInteractiveWindows: Integer;
  begin
    WriteBackendDebug('refresh mode=full-refresh windows=' + ActiveInteractiveWindowHandlesValue.Count.ToString());
    var refreshed := 0;
    var index := 0;
    while index < ActiveInteractiveWindowHandlesValue.Count do
    begin
      if RefreshNativeWindow(ActiveInteractiveWindowHandlesValue[index], ActiveInteractiveWindowsValue[index]) then
      begin
        refreshed := refreshed + 1;
      end;

      index := index + 1;
    end;

    return refreshed;
  end;

  // Experimental and intentionally inactive in the interaction dispatch path.
  // The canonical path is full declarative re-rendering via RefreshInteractiveWindows().
  // Re-enable this only once every supported View type can patch all visible QML state
  // and the smoke logs prove that no stale UI state remains.
  private function TryPatchNativeView(windowHandle: NativeHandle; view: View): Boolean;
  begin
    if view = nil then
    begin
      return true;
    end;

    if view is StackPanel then
    begin
      var panel := view as StackPanel;
      if panel.Children = nil then
      begin
        return true;
      end;

      var children := panel.Children;
      var index := 0;
      while index < children.Count do
      begin
        if TryPatchNativeView(windowHandle, children[index]) = false then
        begin
          return false;
        end;

        index := index + 1;
      end;

      return true;
    end;

    if view is TextBlock then
    begin
      var textBlock := view as TextBlock;
      if HasPatchObjectName(textBlock.Name) = false then
      begin
        return true;
      end;

      var textResult := QtQuickNative.SetElementText(windowHandle, textBlock.Name, textBlock.Text);
      var colorResult := QtQuickNative.SetElementColor(windowHandle, textBlock.Name, ColorToQml(textBlock.Foreground));
      return textResult <> 0 and colorResult <> 0;
    end;

    if view is Button then
    begin
      var button := view as Button;
      if HasPatchObjectName(button.Name) = false then
      begin
        return true;
      end;

      var colorResult := QtQuickNative.SetElementColor(windowHandle, button.Name, ColorToQml(button.Background));
      var labelName := GetButtonLabelObjectName(button);
      if HasPatchObjectName(labelName) = false then
      begin
        return colorResult <> 0;
      end;

      var labelResult := QtQuickNative.SetElementText(windowHandle, labelName, button.Text);
      return colorResult <> 0 and labelResult <> 0;
    end;

    return true;
  end;

  private function TryPatchNativeWindow(windowHandle: NativeHandle; window: Window): Boolean;
  begin
    if windowHandle = NativeHandle.Null or window = nil then
    begin
      return false;
    end;

    var backgroundResult := QtQuickNative.SetWindowBackground(windowHandle, ColorToQml(window.Background));
    var contentResult := TryPatchNativeView(windowHandle, window.Content);
    if backgroundResult <> 0 and contentResult then
    begin
      LastBridgeStatusValue := 'native-window-patched';
      return true;
    end;

    LastBridgeStatusValue := 'native-window-patch-failed';
    return false;
  end;

  private function TryPatchInteractiveWindows: Integer;
  begin
    var patched := 0;
    var index := 0;
    while index < ActiveInteractiveWindowHandlesValue.Count do
    begin
      if TryPatchNativeWindow(ActiveInteractiveWindowHandlesValue[index], ActiveInteractiveWindowsValue[index]) then
      begin
        patched := patched + 1;
      end;

      index := index + 1;
    end;

    return patched;
  end;

  public method RequestTextBoxFocus(textBox: TextBox);
  begin
    PendingFocusTextBoxValue := textBox;
  end;

  private function ResolvePendingFocusTextBoxId: Integer;
  begin
    if PendingFocusTextBoxValue = nil then
    begin
      return 0;
    end;

    var index := 0;
    while index < ActiveTextBoxesValue.Count do
    begin
      if ActiveTextBoxesValue[index] = PendingFocusTextBoxValue then
      begin
        return index + 1;
      end;

      index := index + 1;
    end;

    return 0;
  end;

  private function ApplyPendingTextBoxFocus: Integer;
  begin
    var textBoxId := ResolvePendingFocusTextBoxId();
    PendingFocusTextBoxValue := nil;
    if textBoxId <= 0 then
    begin
      return 0;
    end;

    var focused := 0;
    var index := 0;
    while index < ActiveInteractiveWindowHandlesValue.Count do
    begin
      if QtQuickNative.FocusTextInput(ActiveInteractiveWindowHandlesValue[index], textBoxId) > 0 then
      begin
        focused := focused + 1;
      end;

      index := index + 1;
    end;

    return focused;
  end;

  public static function HandleNativeInteraction(interactionToken: Integer): Integer;
  begin
    var currentBackend := QtQuickBackend.CurrentInteractiveBackend;
    if currentBackend = nil then
    begin
      return 0;
    end;

    return currentBackend.DispatchNativeInteraction(interactionToken);
  end;

  public function DispatchNativeInteraction(interactionToken: Integer): Integer;
  begin
    if interactionToken <= -2000000 then
    begin
      return DispatchNativeSliderChanged((0 - interactionToken) - 2000000);
    end;

    if interactionToken > 0 then
    begin
      return DispatchNativeClick(interactionToken);
    end;

    if interactionToken <= -1000000 then
    begin
      return DispatchNativeCheckBoxToggled((0 - interactionToken) - 1000000);
    end;

    if interactionToken < 0 then
    begin
      return DispatchNativeTextChanged(0 - interactionToken);
    end;

    LastBridgeStatusValue := 'native-interaction-rejected';
    return 0;
  end;

  public function DispatchNativeClick(buttonId: Integer): Integer;
  begin
    var button := FindInteractiveButton(buttonId);
    if button = nil then
    begin
      LastBridgeStatusValue := 'native-click-missing-button';
      return 0;
    end;

    if button.Click() = false then
    begin
      LastBridgeStatusValue := 'native-click-rejected';
      return 0;
    end;

    var refreshed := RefreshInteractiveWindows();
    var focused := ApplyPendingTextBoxFocus();
    if refreshed > 0 then
    begin
      if focused > 0 then
      begin
        LastBridgeStatusValue := 'native-click-dispatched-focus-restored';
      end
      else
      begin
        LastBridgeStatusValue := 'native-click-dispatched';
      end;
    end
    else
    begin
      LastBridgeStatusValue := 'native-click-refresh-failed';
    end;

    return refreshed;
  end;

  public function DispatchNativeSliderChanged(sliderId: Integer): Integer;
  begin
    var slider := FindInteractiveSlider(sliderId);
    if slider = nil then
    begin
      LastBridgeStatusValue := 'native-slider-missing-slider';
      return 0;
    end;

    if NativeBackendHandleValue = NativeHandle.Null then
    begin
      LastBridgeStatusValue := 'native-slider-missing-backend';
      return 0;
    end;

    var currentValue := QtQuickNative.ReadSliderValue(NativeBackendHandleValue, sliderId);
    slider.Value := currentValue;
    var notified := slider.NotifyValueChanged();
    var refreshed := RefreshInteractiveWindows();

    if refreshed > 0 then
    begin
      if notified then
      begin
        LastBridgeStatusValue := 'native-slider-dispatched';
      end
      else
      begin
        LastBridgeStatusValue := 'native-slider-refreshed';
      end;
    end
    else if notified then
    begin
      LastBridgeStatusValue := 'native-slider-notified';
    end
    else
    begin
      LastBridgeStatusValue := 'native-slider-noop';
    end;

    return refreshed;
  end;

  public function DispatchNativeCheckBoxToggled(checkBoxId: Integer): Integer;
  begin
    var checkBox := FindInteractiveCheckBox(checkBoxId);
    if checkBox = nil then
    begin
      LastBridgeStatusValue := 'native-toggle-missing-checkbox';
      return 0;
    end;

    var toggledValue := checkBox.Toggle();
    var notified := checkBox.NotifyToggled();
    var refreshed := RefreshInteractiveWindows();
    if refreshed > 0 then
    begin
      if notified then
      begin
        LastBridgeStatusValue := 'native-toggle-dispatched';
      end
      else if toggledValue then
      begin
        LastBridgeStatusValue := 'native-toggle-on';
      end
      else
      begin
        LastBridgeStatusValue := 'native-toggle-off';
      end;
    end
    else if notified then
    begin
      LastBridgeStatusValue := 'native-toggle-notified';
    end
    else
    begin
      LastBridgeStatusValue := 'native-toggle-noop';
    end;

    return refreshed;
  end;

  public function DispatchNativeTextChanged(textBoxId: Integer): Integer;
  begin
    var textBox := FindInteractiveTextBox(textBoxId);
    if textBox = nil then
    begin
      LastBridgeStatusValue := 'native-text-missing-textbox';
      return 0;
    end;

    if NativeBackendHandleValue = NativeHandle.Null then
    begin
      LastBridgeStatusValue := 'native-text-missing-backend';
      return 0;
    end;

    var currentText := QtQuickNative.ReadTextInputValue(NativeBackendHandleValue, textBoxId);
    textBox.Text := currentText;
    var notified := textBox.NotifyTextChanged();
    PendingFocusTextBoxValue := textBox;
    var refreshed := RefreshInteractiveWindows();
    var focused := ApplyPendingTextBoxFocus();

    if refreshed > 0 then
    begin
      if notified then
      begin
        if focused > 0 then
        begin
          LastBridgeStatusValue := 'native-text-dispatched-focus-restored';
        end
        else
        begin
          LastBridgeStatusValue := 'native-text-dispatched';
        end;
      end
      else
      begin
        LastBridgeStatusValue := 'native-text-refreshed';
      end;
    end
    else if notified then
    begin
      LastBridgeStatusValue := 'native-text-notified';
    end
    else
    begin
      LastBridgeStatusValue := 'native-text-noop';
    end;

    return refreshed;
  end;

  private function EscapeQmlString(value: String): String;
  begin
    if value = nil or value = '' then
    begin
      return '';
    end;

    var result := '';
    var index := 0;
    while index < value.Length do
    begin
      var current := value.Substring(index, 1);
      if current = '"' then
      begin
        result := result + '\' + '"';
      end
      else if current = '\' then
      begin
        result := result + '\' + '\';
      end
      else if current = '
' then
      begin
        result := result + '\' + 'n';
      end
      else if current = '
' then
      begin
        result := result + '\' + 'r';
      end
      else
      begin
        result := result + current;
      end;

      index := index + 1;
    end;

    return result;
  end;

  private function ColorToQml(value: Color): String;
  begin
    if value = Color.Black then
    begin
      return '#111111';
    end;

    if value = Color.White then
    begin
      return '#f4f7fb';
    end;

    if value = Color.Gray then
    begin
      return '#8a94a6';
    end;

    if value = Color.Blue then
    begin
      return '#4c7cf0';
    end;

    if value = Color.Green then
    begin
      return '#38a169';
    end;

    if value = Color.Red then
    begin
      return '#e53e3e';
    end;

    return 'transparent';
  end;

  private function ThicknessToHorizontalPadding(value: Thickness): Integer;
  begin
    if value = nil then
    begin
      return 0;
    end;

    return value.Left + value.Right;
  end;

  private function ThicknessToVerticalPadding(value: Thickness): Integer;
  begin
    if value = nil then
    begin
      return 0;
    end;

    return value.Top + value.Bottom;
  end;

  private function DescribeRootView(view: View): String;
  begin
    if view = nil then
    begin
      return 'ilcRoot';
    end;

    if view.Name <> '' then
    begin
      return view.Name;
    end;

    if view is StackPanel then
    begin
      return 'stackPanel';
    end;

    if view is TextBlock then
    begin
      return 'textBlock';
    end;

    return 'view';
  end;

  private function BuildViewQml(view: View; centerInParent: Boolean): String;
  begin
    if view = nil then
    begin
      return 'Item { width: 1; height: 1 }';
    end;

    if view is StackPanel then
    begin
      var panel := view as StackPanel;
      var containerType := 'Column';
      var spacing := '14';
      var layoutWidth := '380';
      var layoutHeight := 'childrenRect.height';
      if panel.Orientation = Orientation.Horizontal then
      begin
        containerType := 'Row';
        spacing := '12';
        layoutWidth := 'childrenRect.width';
      end;

      if panel.Name = 'demoRoot' then
      begin
        spacing := '16';
      end
      else if panel.Name = 'demoActions' then
      begin
        spacing := '14';
      end
      else if panel.Name = 'demoIntensityRow' then
      begin
        spacing := '10';
        layoutWidth := '380';
      end;

      var result := containerType + ' { spacing: ' + spacing + '; ';
      if centerInParent then
      begin
        result := result + 'id: ilcContentRoot; anchors.centerIn: parent; ';
      end;

      result := result + 'width: ' + layoutWidth + '; height: ' + layoutHeight + '; ';

      if panel.Name <> '' then
      begin
        result := result + 'objectName: "' + EscapeQmlString(panel.Name) + '"; ';
      end;

      var children := panel.Children;
      if children <> nil then
      begin
        var index := 0;
        while index < children.Count do
        begin
          result := result + BuildViewQml(children[index], false) + ' ';
          index := index + 1;
        end;
      end;

      result := result + '}';
      return result;
    end;

    if view is TextBlock then
    begin
      var textBlock := view as TextBlock;
      var fontSize := '18';
      var fontWeight := 'Font.Normal';
      var wrapMode := 'Text.WordWrap';
      var horizontalAlignment := 'Text.AlignLeft';
      var textWidth := '380';
      if textBlock.Name = 'demoTitle' then
      begin
        fontSize := '30';
        fontWeight := 'Font.DemiBold';
      end
      else if textBlock.Name = 'demoEyebrow' then
      begin
        fontSize := '12';
        fontWeight := 'Font.DemiBold';
      end
      else if textBlock.Name = 'demoSubtitle' then
      begin
        fontSize := '15';
      end
      else if textBlock.Name = 'demoStatusLabel' then
      begin
        fontSize := '12';
        fontWeight := 'Font.DemiBold';
      end
      else if textBlock.Name = 'demoStatus' then
      begin
        fontSize := '16';
        fontWeight := 'Font.DemiBold';
      end
      else if textBlock.Name = 'demoHintLabel' then
      begin
        fontSize := '12';
        fontWeight := 'Font.DemiBold';
      end
      else if textBlock.Name = 'demoHint' then
      begin
        fontSize := '14';
      end
      else if textBlock.Name = 'demoInputLabel' then
      begin
        fontSize := '13';
        fontWeight := 'Font.DemiBold';
      end
      else if textBlock.Name = 'demoControlsLabel' then
      begin
        fontSize := '13';
        fontWeight := 'Font.DemiBold';
      end
      else if textBlock.Name = 'demoSummaryLabel' then
      begin
        fontSize := '13';
        fontWeight := 'Font.DemiBold';
      end
      else if textBlock.Name = 'demoSummary' then
      begin
        fontSize := '14';
      end;

      if textBlock.Name = 'demoIntensityLabel' then
      begin
        fontSize := '13';
        fontWeight := 'Font.DemiBold';
        textWidth := '150';
      end
      else if textBlock.Name = 'demoIntensityValue' then
      begin
        fontSize := '13';
        fontWeight := 'Font.DemiBold';
        textWidth := '220';
      end
      else if textBlock.Name = 'demoEyebrow' then
      begin
        textWidth := '380';
      end;

      var textResult := 'Text { ';
      if centerInParent then
      begin
        textResult := textResult + 'anchors.centerIn: parent; ';
      end;

      if textBlock.Name <> '' then
      begin
        textResult := textResult + 'objectName: "' + EscapeQmlString(textBlock.Name) + '"; ';
      end;

      textResult := textResult +
        'text: "' + EscapeQmlString(textBlock.Text) + '"; ' +
        'color: "' + ColorToQml(textBlock.Foreground) + '"; ' +
        'width: ' + textWidth + '; wrapMode: ' + wrapMode + '; horizontalAlignment: ' + horizontalAlignment + '; font.pixelSize: ' + fontSize + '; font.weight: ' + fontWeight + '; ' +
        '}';
      return textResult;
    end;

    if view is Button then
    begin
      var button := view as Button;
      var buttonId := RegisterInteractiveButton(button);
      var buttonBackgroundColor := ColorToQml(button.Background);
      var buttonBorderColor := '#1d4fb5';
      var buttonWidth := '260';
      if button.Background = Color.Red then
      begin
        buttonBorderColor := '#9b2c2c';
      end
      else if button.Background = Color.Green then
      begin
        buttonBorderColor := '#276749';
      end
      else if button.Background = Color.Gray then
      begin
        buttonBorderColor := '#4a5568';
      end;

      if button.Name = 'demoButton' then
      begin
        buttonWidth := '248';
      end
      else if button.Name = 'demoResetButton' then
      begin
        buttonWidth := '120';
      end;

      var buttonResult := 'Rectangle { width: ' + buttonWidth + '; height: 46; radius: 10; color: "' + buttonBackgroundColor + '"; border.width: 1; border.color: "' + buttonBorderColor + '"; ';
      if centerInParent then
      begin
        buttonResult := buttonResult + 'anchors.centerIn: parent; ';
      end;

      if button.Name <> '' then
      begin
        buttonResult := buttonResult + 'objectName: "' + EscapeQmlString(button.Name) + '"; ';
      end;

      buttonResult := buttonResult +
        'property int ilcButtonId: ' + EncodeButtonInteraction(buttonId).ToString() + '; ' +
        'MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: { if (ilcBridge !== null) { ilcBridge.onButtonClicked(parent.ilcButtonId); } } } ' +
        'Text { objectName: "' + EscapeQmlString(GetButtonLabelObjectName(button)) + '"; anchors.centerIn: parent; color: "#f4f7fb"; text: "' + EscapeQmlString(button.Text) + '" } ' +
        '}';
      return buttonResult;
    end;

    if view is CheckBox then
    begin
      var checkBox := view as CheckBox;
      var checkBoxId := RegisterInteractiveCheckBox(checkBox);
      var markColor := '#8a94a6';
      var markVisible := 'false';
      if checkBox.IsChecked then
      begin
        markColor := '#38a169';
        markVisible := 'true';
      end;

      var checkBoxResult := 'Item { width: 380; height: 28; ';
      if centerInParent then
      begin
        checkBoxResult := checkBoxResult + 'anchors.centerIn: parent; ';
      end;

      if checkBox.Name <> '' then
      begin
        checkBoxResult := checkBoxResult + 'objectName: "' + EscapeQmlString(checkBox.Name) + '"; ';
      end;

      checkBoxResult := checkBoxResult +
        'property int ilcCheckBoxId: ' + EncodeCheckBoxInteraction(checkBoxId).ToString() + '; ' +
        'Row { anchors.verticalCenter: parent.verticalCenter; spacing: 12; ' +
        'Rectangle { width: 22; height: 22; radius: 6; color: "#232a35"; border.width: 1; border.color: "#4a5568"; ' +
        'Rectangle { visible: ' + markVisible + '; anchors.centerIn: parent; width: 12; height: 12; radius: 4; color: "' + markColor + '"; } } ' +
        'Text { text: "' + EscapeQmlString(checkBox.Text) + '"; color: "#d8e1ee"; verticalAlignment: Text.AlignVCenter; font.pixelSize: 15; } ' +
        '} ' +
        'MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: { if (ilcBridge !== null) { ilcBridge.onButtonClicked(parent.ilcCheckBoxId); } } } ' +
        '}';
      return checkBoxResult;
    end;

    if view is TextBox then
    begin
      var textBox := view as TextBox;
      var textBoxId := RegisterInteractiveTextBox(textBox);
      var horizontalPadding := 16 + ThicknessToHorizontalPadding(textBox.Padding);
      var verticalPadding := 10 + ThicknessToVerticalPadding(textBox.Padding);
      var readOnlyText := 'false';
      var inputText := textBox.Text;
      var placeholderText := textBox.PlaceholderText;
      var inputObjectName := 'ilcTextInput_' + textBoxId.ToString();
      if textBox.IsReadOnly then
      begin
        readOnlyText := 'true';
      end;

      var textBoxResult := 'Rectangle { width: 380; height: 52; radius: 10; color: "#232a35"; border.width: 1; border.color: "#4a5568"; ';
      if centerInParent then
      begin
        textBoxResult := textBoxResult + 'anchors.centerIn: parent; ';
      end;

      if textBox.Name <> '' then
      begin
        textBoxResult := textBoxResult + 'objectName: "' + EscapeQmlString(textBox.Name) + '"; ';
      end;

      textBoxResult := textBoxResult +
        'property int ilcTextBoxId: ' + textBoxId.ToString() + '; ' +
        'TextInput { id: textInput; objectName: "' + inputObjectName + '"; anchors.fill: parent; anchors.leftMargin: ' + horizontalPadding.ToString() + '; anchors.rightMargin: ' + horizontalPadding.ToString() + '; anchors.topMargin: ' + verticalPadding.ToString() + '; anchors.bottomMargin: ' + verticalPadding.ToString() + '; ' +
        'readOnly: ' + readOnlyText + '; ' +
        'text: "' + EscapeQmlString(inputText) + '"; ' +
        'color: "#f4f7fb"; ' +
        'onTextEdited: { if (ilcBridge !== null) { ilcBridge.onTextEdited(parent.ilcTextBoxId, textInput.text); } } ' +
        'selectionColor: "#4c7cf0"; selectedTextColor: "#f4f7fb"; } ' +
        'Text { visible: textInput.text.length === 0; anchors.fill: parent; anchors.leftMargin: ' + horizontalPadding.ToString() + '; anchors.rightMargin: ' + horizontalPadding.ToString() + '; anchors.topMargin: ' + verticalPadding.ToString() + '; anchors.bottomMargin: ' + verticalPadding.ToString() + '; text: "' + EscapeQmlString(placeholderText) + '"; color: "#bac4d3"; verticalAlignment: Text.AlignVCenter; } ' +
        '}';
      return textBoxResult;
    end;

    if view is Slider then
    begin
      var slider := view as Slider;
      var sliderId := RegisterInteractiveSlider(slider);
      var sliderFrom := slider.Minimum.ToString() + '.0';
      var sliderTo := slider.Maximum.ToString() + '.0';
      var sliderValue := slider.Value.ToString() + '.0';
      var sliderResult := 'Item { width: 380; height: 40; ';
      if centerInParent then
      begin
        sliderResult := sliderResult + 'anchors.centerIn: parent; ';
      end;

      if slider.Name <> '' then
      begin
        sliderResult := sliderResult + 'objectName: "' + EscapeQmlString(slider.Name) + '"; ';
      end;

      sliderResult := sliderResult +
        'property int ilcSliderId: ' + sliderId.ToString() + '; ' +
        'Slider { id: sliderControl; anchors.fill: parent; from: ' + sliderFrom + '; to: ' + sliderTo + '; value: ' + sliderValue + '; stepSize: 1.0; ' +
        'onPressedChanged: { if (!sliderControl.pressed && ilcBridge !== null) { ilcBridge.onSliderValueChanged(parent.ilcSliderId, Math.round(sliderControl.value)); } } ' +
        '} ' +
        '}';
      return sliderResult;
    end;

    var fallback := 'Rectangle { width: 180; height: 40; radius: 6; color: "#313844"; ';
    if centerInParent then
    begin
      fallback := fallback + 'anchors.centerIn: parent; ';
    end;

    if view.Name <> '' then
    begin
      fallback := fallback + 'objectName: "' + EscapeQmlString(view.Name) + '"; ';
    end;

    fallback := fallback + 'Text { anchors.centerIn: parent; color: "#f4f7fb"; text: "' + EscapeQmlString(DescribeRootView(view)) + '" } }';
    return fallback;
  end;

  private function BuildWindowContentQml(window: Window): String;
  begin
    var rootName := 'ilcRoot';
    if window <> nil and window.Content <> nil then
    begin
      rootName := DescribeRootView(window.Content);
    end;

    var backgroundColor := '#20252b';
    if window <> nil then
    begin
      backgroundColor := ColorToQml(window.Background);
      if backgroundColor = 'transparent' then
      begin
        backgroundColor := '#20252b';
      end;
    end;

    var windowWidth := 640;
    var windowHeight := 480;
    if window <> nil then
    begin
      windowWidth := window.Width;
      windowHeight := window.Height;
    end;

    var contentQml := BuildViewQml(window.Content, true);
    return
      'import QtQuick' + '
' +
      'import QtQuick.Controls' + '
' +
      'Rectangle { width: ' + windowWidth.ToString() + '; height: ' + windowHeight.ToString() + '; color: "' + backgroundColor + '"; objectName: "' + EscapeQmlString(rootName) + '"; ' +
      'Rectangle { width: 468; height: Math.max(160, parent.height - 96); anchors.centerIn: parent; radius: 22; color: "#171c24"; border.width: 1; border.color: "#2a3240"; opacity: 0.98; } ' +
      contentQml +
      ' }';
  end;

  public function Run(application: Application): Integer;
  begin
    EngineInitializedValue := true;
    ResetInteractiveSession();
    LastInteractiveWindowHandleValue := NativeHandle.Null;
    LastHostedWindowTitleValue := '';
    LastHostedRootDescriptionValue := '';

    if NativeBridgeEnabledValue then
    begin
      if NativeBackendHandleValue = NativeHandle.Null then
      begin
        NativeBackendHandleValue := QtQuickNative.CreateBackend();
      end;

      if NativeBackendHandleValue = NativeHandle.Null then
      begin
        LastBridgeStatusValue := 'native-backend-create-failed';
        return 0;
      end;

      var nativeHosted := 0;
      var nativeWindowHandles := new List<NativeHandle>();
      if application <> nil and application.Windows <> nil then
      begin
        var windows := application.Windows;
        var windowEnumerator := windows.GetEnumerator();
        while windowEnumerator.MoveNext() do
        begin
          var currentWindow := windowEnumerator.Current;
          if currentWindow <> nil then
          begin
            LastHostedWindowTitleValue := currentWindow.Title;
            LastHostedRootDescriptionValue := DescribeRootView(currentWindow.Content);

            var nativeWindowHandle := QtQuickNative.CreateWindow(NativeBackendHandleValue, currentWindow.Title);
            if nativeWindowHandle = NativeHandle.Null then
            begin
              LastBridgeStatusValue := 'native-window-create-failed';
            end
            else
            begin
              nativeWindowHandles.Add(nativeWindowHandle);
              TrackInteractiveWindow(currentWindow, nativeWindowHandle);
              var showResult := 0;
              if RefreshNativeWindow(nativeWindowHandle, currentWindow) then
              begin
                showResult := QtQuickNative.ShowWindow(nativeWindowHandle);
              end
              else
              begin
                LastBridgeStatusValue := 'native-window-qml-failed';
              end;

              if showResult <> 0 then
              begin
                nativeHosted := nativeHosted + 1;
              end;
            end;
          end;
        end;
      end;

      QtQuickBackend.CurrentInteractiveBackend := self;
      var runResult := QtQuickNative.RunBackendWithClickCallback(NativeBackendHandleValue, QtQuickBackend.HandleNativeInteraction);
      QtQuickBackend.CurrentInteractiveBackend := nil;
      var destroyIndex := 0;
      while destroyIndex < nativeWindowHandles.Count do
      begin
        QtQuickNative.DestroyWindow(nativeWindowHandles[destroyIndex]);
        destroyIndex := destroyIndex + 1;
      end;

      QtQuickNative.DestroyBackend(NativeBackendHandleValue);
      NativeBackendHandleValue := NativeHandle.Null;
      LastInteractiveWindowHandleValue := NativeHandle.Null;
      ResetInteractiveSession();
      if runResult <> 0 then
      begin
        LastBridgeStatusValue := 'native-bridge-rendered-qml';
      end
      else
      begin
        LastBridgeStatusValue := 'native-bridge-run-failed';
      end;

      return nativeHosted;
    end
    else
    begin
      LastBridgeStatusValue := 'managed-fallback';
    end;

    var hosted := FallbackBackendValue.Run(application);
    var debugBackend := FallbackBackendValue as DebugUiBackend;
    if debugBackend <> nil then
    begin
      LastHostedRootDescriptionValue := debugBackend.LastRootDescription;
    end;

    if application <> nil then
    begin
      var windows := application.Windows;
      if windows <> nil then
      begin
        var enumerator := windows.GetEnumerator();
        while enumerator.MoveNext() do
        begin
          if enumerator.Current <> nil then
          begin
            LastHostedWindowTitleValue := enumerator.Current.Title;
          end;
        end;
      end;
    end;

    return hosted;
  end;

  public function RefreshNativeWindow(windowHandle: NativeHandle; window: Window): Boolean;
  begin
    if windowHandle = NativeHandle.Null or window = nil then
    begin
      LastBridgeStatusValue := 'native-window-refresh-rejected';
      return false;
    end;

    LastHostedWindowTitleValue := window.Title;
    LastHostedRootDescriptionValue := DescribeRootView(window.Content);
    var minSizeResult := QtQuickNative.SetWindowMinimumSize(windowHandle, window.MinWidth, window.MinHeight);
    var sizeResult := QtQuickNative.SetWindowSize(windowHandle, window.Width, window.Height);
    var rootNameResult := QtQuickNative.SetRootName(windowHandle, LastHostedRootDescriptionValue);
    var qmlResult := QtQuickNative.SetContentQml(windowHandle, BuildWindowContentQml(window));
    if minSizeResult <> 0 and sizeResult <> 0 and rootNameResult <> 0 and qmlResult <> 0 then
    begin
      LastBridgeStatusValue := 'native-window-refreshed';
      return true;
    end;

    LastBridgeStatusValue := 'native-window-refresh-failed';
    return false;
  end;
end;
