// GitHub   : https://github.com/schnullibulli80
// Comment  : This file contains the first shipped, backend-neutral UI object model for ILC. It is intentionally small and purely managed:
//            application/window/view structure, a minimal command abstraction, and a few basic controls. Rendering and native hosting stay out
//            of scope for this slice.
//
// Type     : ILC source code fixture
// Date     : 2026-04-10
// History  :
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
namespace System.Ui;

uses System, System.Collections, System.Threading;

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • ENUM • Orientation
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Specifies the orientation of a UI element.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public enum Orientation
begin
  Horizontal = 0;
  Vertical = 1;
end;
//══ end of enum ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • ENUM • Visibility
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Specifies the visibility of a UI element.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public enum Visibility
begin
  Visible = 0;
  Hidden = 1;
  Collapsed = 2;
end;
//══ end of enum ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • ENUM • DialogResult
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public enum DialogResult
begin
  None = 0;
  Accepted = 1;
  Cancelled = 2;
end;
//══ end of enum ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • ENUM • Color
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Specifies a color for UI elements. This is a placeholder for a more complete color abstraction in the future.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public enum Color
begin
  Transparent = 0;
  Black = 1;
  White = 2;
  Gray = 3;
  Blue = 4;
  Green = 5;
  Red = 6;
end;
//══ end of enum ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • INTERFACE • ICommand
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Defines a command that can be executed and queried for its ability to execute.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public interface ICommand
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Execute
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Executes the command's action.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Execute;
  
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • CanExecute
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Determines whether the command can execute in its current state.</summary>
  /// <returns><c>true</c> if the command can execute; otherwise, <c>false</c>.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function CanExecute: Boolean;
end;
//══ end of interface ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Thickness
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>
///   Represents the thickness of a UI element's border, margin, or padding. This is a placeholder for a more complete thickness abstraction in 
///   the future.
/// </summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Thickness
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The thickness on the left side.</summary>
  private var LeftValue: Integer;
  /// <summary>The thickness on the top side.</summary>
  private var TopValue: Integer;
  /// <summary>The thickness on the right side.</summary>
  private var RightValue: Integer;
  /// <summary>The thickness on the bottom side.</summary>
  private var BottomValue: Integer;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The thickness on the left side.</summary>
  public property Left: Integer
  begin
    get
    begin
      return LeftValue;
    end;

    set(value)
    begin
      if value < 0 then
      begin
        LeftValue := 0;
      end
      else
      begin
        LeftValue := value;
      end;
    end;
  end;

  /// <summary>The thickness on the top side.</summary>
  public property Top: Integer
  begin
    get
    begin
      return TopValue;
    end;

    set(value)
    begin
      if value < 0 then
      begin
        TopValue := 0;
      end
      else
      begin
        TopValue := value;
      end;
    end;
  end;

  /// <summary>The thickness on the right side.</summary>
  public property Right: Integer
  begin
    get
    begin
      return RightValue;
    end;

    set(value)
    begin
      if value < 0 then
      begin
        RightValue := 0;
      end
      else
      begin
        RightValue := value;
      end;
    end;
  end;

  /// <summary>The thickness on the bottom side.</summary>
  public property Bottom: Integer
  begin
    get
    begin
      return BottomValue;
    end;

    set(value)
    begin
      if value < 0 then
      begin
        BottomValue := 0;
      end
      else
      begin
        BottomValue := value;
      end;
    end;
  end;

  /// <summary>The combined thickness of the left and right sides.</summary>
  public property Horizontal: Integer
  begin
    get
    begin
      return LeftValue + RightValue;
    end;
  end;

  /// <summary>The combined thickness of the top and bottom sides.</summary>
  public property Vertical: Integer
  begin
    get
    begin
      return TopValue + BottomValue;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Thickness"/> class with all sides set to zero.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    LeftValue := 0;
    TopValue := 0;
    RightValue := 0;
    BottomValue := 0;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Thickness"/> class with all sides set to the specified value.</summary>
  /// <param name="all">The value to set for all sides.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor(all: Integer);
  begin
    Left := all;
    Top := all;
    Right := all;
    Bottom := all;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>
  ///   Initializes a new instance of the <see cref="Thickness"/> class with the horizontal sides set to one value and the vertical sides set to 
  ///   another value.
  /// </summary>
  /// <param name="horizontal">The value to set for the left and right sides.</param>
  /// <param name="vertical">The value to set for the top and bottom sides.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor(horizontal: Integer; vertical: Integer);
  begin
    Left := horizontal;
    Right := horizontal;
    Top := vertical;
    Bottom := vertical;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Thickness"/> class with the specified values for each side.</summary>
  /// <param name="left">The value to set for the left side.</param>
  /// <param name="top">The value to set for the top side.</param>
  /// <param name="right">The value to set for the right side.</param>
  /// <param name="bottom">The value to set for the bottom side.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor(left: Integer; top: Integer; right: Integer; bottom: Integer);
  begin
    Left := left;
    Top := top;
    Right := right;
    Bottom := bottom;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Style
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>
///   Represents the style of a UI element, including its foreground and background colors, margin, and padding. This is a placeholder for a 
///   more complete style abstraction in the future.
/// </summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Style
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The foreground color of the styled element.</summary>
  private var ForegroundValue: Color;
  /// <summary>The background color of the styled element.</summary>
  private var BackgroundValue: Color;
  /// <summary>The margin of the styled element.</summary>
  private var MarginValue: Thickness;
  /// <summary>The padding of the styled element.</summary>
  private var PaddingValue: Thickness;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The foreground color of the styled element.</summary>
  public property Foreground: Color
  begin
    get
    begin
      return ForegroundValue;
    end;

    set(value)
    begin
      ForegroundValue := value;
    end;
  end;

  /// <summary>The background color of the styled element.</summary>
  public property Background: Color
  begin
    get
    begin
      return BackgroundValue;
    end;

    set(value)
    begin
      BackgroundValue := value;
    end;
  end;

  /// <summary>The margin of the styled element.</summary>
  public property Margin: Thickness
  begin
    get
    begin
      return MarginValue;
    end;

    set(value)
    begin
      if value = nil then
      begin
        MarginValue := new Thickness();
        return;
      end;

      MarginValue := value;
    end;
  end;

  /// <summary>The padding of the styled element.</summary>
  public property Padding: Thickness
  begin
    get
    begin
      return PaddingValue;
    end;

    set(value)
    begin
      if value = nil then
      begin
        PaddingValue := new Thickness();
        return;
      end;

      PaddingValue := value;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Style"/> class with default values for all properties.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    ForegroundValue := Color.Black;
    BackgroundValue := Color.Transparent;
    MarginValue := new Thickness();
    PaddingValue := new Thickness();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • ApplyToTextBlock
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Applies the style to a <see cref="TextBlock"/> instance.</summary>
  /// <param name="target">The <see cref="TextBlock"/> instance to apply the style to.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method ApplyToTextBlock(target: TextBlock);
  begin
    if target = nil then
    begin
      return;
    end;

    target.Foreground := ForegroundValue;
    target.Margin := MarginValue;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • ApplyToTextBox
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Applies the style to a <see cref="TextBox"/> instance.</summary>
  /// <param name="target">The <see cref="TextBox"/> instance to apply the style to.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method ApplyToTextBox(target: TextBox);
  begin
    if target = nil then
    begin
      return;
    end;

    target.Margin := MarginValue;
    target.Padding := PaddingValue;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • ApplyToBorder
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Applies the style to a <see cref="Border"/> instance.</summary>
  /// <param name="target">The <see cref="Border"/> instance to apply the style to.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method ApplyToBorder(target: Border);
  begin
    if target = nil then
    begin
      return;
    end;

    target.Background := BackgroundValue;
    target.Margin := MarginValue;
    target.Padding := PaddingValue;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • ApplyToWindow
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Applies the style to a <see cref="Window"/> instance.</summary>
  /// <param name="target">The <see cref="Window"/> instance to apply the style to.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method ApplyToWindow(target: Window);
  begin
    if target = nil then
    begin
      return;
    end;

    target.Background := BackgroundValue;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • ObservableObject
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents an object that can notify observers of changes to its state.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class ObservableObject
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>A version number that increments each time the object's state changes.</summary>
  private var ChangeVersionValue: Integer;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the current change version of the object.</summary>
  public property ChangeVersion: Integer
  begin
    get
    begin
      return ChangeVersionValue;
    end;
  end;

  /// <summary>Gets a value indicating whether the object has changes.</summary>
  public property HasChanges: Boolean
  begin
    get
    begin
      return ChangeVersionValue > 0;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="ObservableObject"/> class with no changes.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    ChangeVersionValue := 0;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • MarkChanged
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Marks the object as changed, incrementing the change version.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  protected method MarkChanged;
  begin
    ChangeVersionValue := ChangeVersionValue + 1;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Touch
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Marks the object as changed, incrementing the change version.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Touch;
  begin
    MarkChanged();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • AcceptChanges
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Resets the change version, marking the object as unchanged.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method AcceptChanges;
  begin
    ChangeVersionValue := 0;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • ObservableText
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a text value that can notify observers of changes to its content.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class ObservableText: ObservableObject
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The current text value.</summary>
  private var TextValue: String;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the text value.</summary>
  public property Text: String
  begin
    get
    begin
      return TextValue;
    end;

    set(value)
    begin
      if TextValue = value then
      begin
        return;
      end;

      TextValue := value;
      MarkChanged();
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="ObservableText"/> class with the specified initial text.</summary>
  /// <param name="initialText">The initial text value.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor(initialText: String);
  begin
    TextValue := '';
    Text := initialText;
    AcceptChanges();
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Command
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a command that can be executed.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Command: ICommand
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The action to execute when the command is invoked.</summary>
  private var ActionValue: IRunnable;
  /// <summary>A value indicating whether the command is enabled.</summary>
  private var EnabledValue: Boolean;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets a value indicating whether the command is enabled.</summary>
  public property IsEnabled: Boolean
  begin
    get
    begin
      return EnabledValue;
    end;

    set(value)
    begin
      EnabledValue := value;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Command"/> class with the specified action.</summary>
  /// <param name="action">The action to execute when the command is invoked.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor(action: IRunnable);
  begin
    ActionValue := action;
    EnabledValue := action <> nil;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Execute
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Executes the command's action if the command is enabled.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Execute;
  begin
    if CanExecute() = false then
    begin
      return;
    end;

    ActionValue.Run();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • CanExecute
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Determines whether the command can be executed.</summary>
  /// <returns><c>true</c> if the command can be executed; otherwise, <c>false</c>.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function CanExecute: Boolean;
  begin
    return EnabledValue and ActionValue <> nil;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • View
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a UI element that can be displayed on the screen. This is a base class for all UI elements in the ILC UI framework.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The name of the view, which can be used for identification purposes.</summary>
  private var NameValue: String;
  /// <summary>The visibility of the view.</summary>
  private var VisibilityValue: Visibility;
  /// <summary>The margin around the view.</summary>
  private var MarginValue: Thickness;
  /// <summary>The data context associated with the view, which can be used for data binding.</summary>
  private var DataContextValue: Object;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The name of the view, which can be used for identification purposes.</summary>
  public property Name: String
  begin
    get
    begin
      return NameValue;
    end;

    set(value)
    begin
      NameValue := value;
    end;
  end;

  /// <summary>The visibility of the view.</summary>
  public property Visibility: Visibility
  begin
    get
    begin
      return VisibilityValue;
    end;

    set(value)
    begin
      VisibilityValue := value;
    end;
  end;

  /// <summary>Indicates whether the view is visible.</summary>
  public property IsVisible: Boolean
  begin
    get
    begin
      return VisibilityValue = Visibility.Visible;
    end;
  end;

  /// <summary>The margin around the view.</summary>
  public property Margin: Thickness
  begin
    get
    begin
      return MarginValue;
    end;

    set(value)
    begin
      if value = nil then
      begin
        MarginValue := new Thickness();
        return;
      end;

      MarginValue := value;
    end;
  end;

  /// <summary>The data context associated with the view, which can be used for data binding.</summary>
  public property DataContext: Object
  begin
    get
    begin
      return DataContextValue;
    end;

    set(value)
    begin
      DataContextValue := value;
    end;
  end;

  /// <summary>Indicates whether the view has a data context.</summary>
  public property HasDataContext: Boolean
  begin
    get
    begin
      return DataContextValue <> nil;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="View"/> class with default values for all properties.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeView();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • InitializeView
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes the view with default values for all properties.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  protected method InitializeView;
  begin
    NameValue := '';
    VisibilityValue := Visibility.Visible;
    MarginValue := new Thickness();
    DataContextValue := nil;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • InheritDataContextTo
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Inherits the data context to the specified target view.</summary>
  /// <param name="target">The target view to inherit the data context.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  protected method InheritDataContextTo(target: View);
  begin
    if target = nil or target.HasDataContext or DataContextValue = nil then
    begin
      return;
    end;

    target.DataContext := DataContextValue;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Container
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that can contain child views. This is a base class for all container views in the ILC UI framework.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Container: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The list of child views contained within the container.</summary>
  private var ChildrenValue: List<View>;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the list of child views contained within the container.</summary>
  public property Children: List<View>
  begin
    get
    begin
      return ChildrenValue;
    end;
  end;

  /// <summary>Gets the number of child views contained within the container.</summary>
  public property ChildCount: Integer
  begin
    get
    begin
      return ChildrenValue.Count;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Container"/> class with an empty list of child views.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeContainer();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • InitializeContainer
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes the container with an empty list of child views.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  protected method InitializeContainer;
  begin
    InitializeView();
    ChildrenValue := new List<View>();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • AddChild
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Adds a child view to the container.</summary>
  /// <param name="view">The child view to add.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method AddChild(view: View);
  begin
    if view = nil then
    begin
      raise new Exception('UI child must not be nil.');
    end;

    InheritDataContextTo(view);
    ChildrenValue.Add(view);
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Panel
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>
///   Represents a simple container that can hold child views. This is a base class for more specific panel types in the ILC UI framework.
/// </summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Panel: Container
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Panel"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeContainer();
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • ContentControl
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>
///   Represents a container that can hold a single child view as its content. This is a base class for more specific content control types in 
///   the ILC UI framework.
/// </summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class ContentControl: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The child view that is set as the content of the control.</summary>
  private var ContentValue: View;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the child view that is set as the content of the control.</summary>
  public property Content: View
  begin
    get
    begin
      return ContentValue;
    end;

    set(value)
    begin
      SetContentCore(value);
    end;
  end;

  /// <summary>Gets a value indicating whether the control has content.</summary>
  public property HasContent: Boolean
  begin
    get
    begin
      return ContentValue <> nil;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="ContentControl"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeContentControl();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • InitializeContentControl
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes the content control with default values for all properties.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  protected method InitializeContentControl;
  begin
    InitializeView();
    ContentValue := nil;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • GetContentCore
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the content of the control.</summary>
  /// <returns>The content of the control.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  protected function GetContentCore: View;
  begin
    return ContentValue;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • SetContentCore
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Sets the content of the control.</summary>
  /// <param name="value">The content to set.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  protected method SetContentCore(value: View);
  begin
    ContentValue := value;
    InheritDataContextTo(ContentValue);
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • TextBlock
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that displays a block of text.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class TextBlock: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The text to display in the text block.</summary>
  private var TextValue: String;
  /// <summary>The foreground color of the text.</summary>
  private var ForegroundValue: Color;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="TextBlock"/> class.</summary>
  public property Text: String
  begin
    get
    begin
      return TextValue;
    end;

    set(value)
    begin
      TextValue := value;
    end;
  end;

  /// <summary>Gets or sets the foreground color of the text.</summary>
  public property Foreground: Color
  begin
    get
    begin
      return ForegroundValue;
    end;

    set(value)
    begin
      ForegroundValue := value;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="TextBlock"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeView();
    TextValue := '';
    ForegroundValue := Color.Black;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Button
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that displays a button that can be clicked to perform an action.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Button: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The text displayed on the button.</summary>
  private var TextValue: String;
  /// <summary>The command that is executed when the button is clicked.</summary>
  private var CommandValue: ICommand;
  /// <summary>The background color of the button.</summary>
  private var BackgroundValue: Color;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the text displayed on the button.</summary>
  public property Text: String
  begin
    get
    begin
      return TextValue;
    end;

    set(value)
    begin
      TextValue := value;
    end;
  end;

  /// <summary>Gets or sets the command that is executed when the button is clicked.</summary>
  public property Command: ICommand
  begin
    get
    begin
      return CommandValue;
    end;

    set(value)
    begin
      CommandValue := value;
    end;
  end;

  /// <summary>Gets or sets the background color of the button.</summary>
  public property Background: Color
  begin
    get
    begin
      return BackgroundValue;
    end;

    set(value)
    begin
      BackgroundValue := value;
    end;
  end;

  /// <summary>Gets a value indicating whether the button can be clicked, which is determined by whether the command is set and can be executed.</summary>
  public property CanClick: Boolean
  begin
    get
    begin
      return CommandValue <> nil and CommandValue.CanExecute();
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Button"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeView();
    TextValue := '';
    CommandValue := nil;
    BackgroundValue := Color.Blue;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Click
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Clicks the button, executing its command if it can be clicked.</summary>
  /// <returns><c>true</c> if the button was clicked; otherwise, <c>false</c>.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function Click: Boolean;
  begin
    if CanClick = false then
    begin
      return false;
    end;

    CommandValue.Execute();
    return true;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • CheckBox
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that displays a checkbox that can be checked or unchecked.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class CheckBox: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The text displayed next to the checkbox.</summary>
  private var TextValue: String;
  /// <summary>A value indicating whether the checkbox is checked.</summary>
  private var IsCheckedValue: Boolean;
  /// <summary>The command executed when the checked state changes.</summary>
  private var ToggledCommandValue: ICommand;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the text displayed next to the checkbox.</summary>
  public property Text: String
  begin
    get
    begin
      return TextValue;
    end;

    set(value)
    begin
      TextValue := value;
    end;
  end;

  /// <summary>Gets or sets a value indicating whether the checkbox is checked.</summary>
  public property IsChecked: Boolean
  begin
    get
    begin
      return IsCheckedValue;
    end;

    set(value)
    begin
      IsCheckedValue := value;
    end;
  end;

  /// <summary>Gets or sets the command executed when the checked state changes.</summary>
  public property ToggledCommand: ICommand
  begin
    get
    begin
      return ToggledCommandValue;
    end;

    set(value)
    begin
      ToggledCommandValue := value;
    end;
  end;

  /// <summary>Gets a value indicating whether the checkbox can notify that it has been toggled.</summary>
  public property CanNotifyToggled: Boolean
  begin
    get
    begin
      return ToggledCommandValue <> nil and ToggledCommandValue.CanExecute();
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="CheckBox"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeView();
    TextValue := '';
    IsCheckedValue := false;
    ToggledCommandValue := nil;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Toggle
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Toggles the checked state of the checkbox.</summary>
  /// <returns>The new checked state of the checkbox after toggling.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function Toggle: Boolean;
  begin
    if IsCheckedValue then
    begin
      IsCheckedValue := false;
      return false;
    end;

    IsCheckedValue := true;
    return true;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • NotifyToggled
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Notifies that the checked state of the checkbox has been toggled, executing the toggled command if it can notify.</summary>
  /// <returns><c>true</c> if the toggled command was executed; otherwise, <c>false</c>.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function NotifyToggled: Boolean;
  begin
    if CanNotifyToggled = false then
    begin
      return false;
    end;

    ToggledCommandValue.Execute();
    return true;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Slider
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that displays a slider that can be used to select a value from a range.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Slider: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The minimum value of the slider.</summary>
  private var MinimumValue: Integer;
  /// <summary>The maximum value of the slider.</summary>
  private var MaximumValue: Integer;
  /// <summary>The current value of the slider.</summary>
  private var ValueValue: Integer;
  // <summary>The command executed when the slider value changes.</summary>
  private var ValueChangedCommandValue: ICommand;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The minimum value of the slider.</summary>
  public property Minimum: Integer
  begin
    get
    begin
      return MinimumValue;
    end;

    set(value)
    begin
      MinimumValue := value;
      if MaximumValue < MinimumValue then
      begin
        MaximumValue := MinimumValue;
      end;

      if ValueValue < MinimumValue then
      begin
        ValueValue := MinimumValue;
      end;
    end;
  end;

  /// <summary>The maximum value of the slider.</summary>
  public property Maximum: Integer
  begin
    get
    begin
      return MaximumValue;
    end;

    set(value)
    begin
      MaximumValue := value;
      if MaximumValue < MinimumValue then
      begin
        MinimumValue := MaximumValue;
      end;

      if ValueValue > MaximumValue then
      begin
        ValueValue := MaximumValue;
      end;
    end;
  end;

  /// <summary>The current value of the slider.</summary>
  public property Value: Integer
  begin
    get
    begin
      return ValueValue;
    end;

    set(value)
    begin
      if value < MinimumValue then
      begin
        ValueValue := MinimumValue;
        return;
      end;

      if value > MaximumValue then
      begin
        ValueValue := MaximumValue;
        return;
      end;

      ValueValue := value;
    end;
  end;

  /// <summary>Gets or sets the command executed when the slider value changes.</summary>
  public property ValueChangedCommand: ICommand
  begin
    get
    begin
      return ValueChangedCommandValue;
    end;
    set(value)
    begin
      ValueChangedCommandValue := value;
    end;
  end;
  
  /// <summary>Gets a value indicating whether the slider can notify that its value has changed.</summary>
  public property CanNotifyValueChanged: Boolean
  begin
    get
    begin
      return ValueChangedCommandValue <> nil and ValueChangedCommandValue.CanExecute();
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Slider"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeView();
    MinimumValue := 0;
    MaximumValue := 100;
    ValueValue := 0;
    ValueChangedCommandValue := nil;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • SetRange
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Sets the minimum and maximum values of the slider, ensuring that the current value remains within the new range.</summary>
  /// <param name="minimum">The minimum value to set.</param>
  /// <param name="maximum">The maximum value to set.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method SetRange(minimum: Integer; maximum: Integer);
  begin
    MinimumValue := minimum;
    MaximumValue := maximum;

    if MaximumValue < MinimumValue then
    begin
      MaximumValue := MinimumValue;
    end;

    if ValueValue < MinimumValue then
    begin
      ValueValue := MinimumValue;
      return;
    end;

    if ValueValue > MaximumValue then
    begin
      ValueValue := MaximumValue;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • NotifyValueChanged
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Notifies that the slider value has changed, executing the value changed command if it can notify.</summary>
  /// <returns><c>true</c> if the value changed command was executed; otherwise, <c>false</c>.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function NotifyValueChanged: Boolean;
  begin
    if CanNotifyValueChanged = false then
    begin
      return false;
    end;
    ValueChangedCommandValue.Execute();
    return true;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • TextBox
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that displays a text box that can be used to enter and edit text.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class TextBox: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The text entered in the text box.</summary>
  private var TextValue: String;
  /// <summary>The placeholder text displayed when the text box is empty.</summary>
  private var PlaceholderTextValue: String;
  /// <summary>A value indicating whether the text box is read-only.</summary>
  private var IsReadOnlyValue: Boolean;
  /// <summary>The padding inside the text box.</summary>
  private var PaddingValue: Thickness;
  /// <summary>The command to execute when the text changes.</summary>
  private var TextChangedCommandValue: ICommand;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The text entered in the text box.</summary>
  public property Text: String
  begin
    get
    begin
      return TextValue;
    end;

    set(value)
    begin
      if IsReadOnlyValue then
      begin
        return;
      end;

      TextValue := value;
    end;
  end;

  /// <summary>The placeholder text displayed when the text box is empty.</summary>
  public property PlaceholderText: String
  begin
    get
    begin
      return PlaceholderTextValue;
    end;

    set(value)
    begin
      PlaceholderTextValue := value;
    end;
  end;

  /// <summary>A value indicating whether the text box is read-only.</summary>
  public property IsReadOnly: Boolean
  begin
    get
    begin
      return IsReadOnlyValue;
    end;

    set(value)
    begin
      IsReadOnlyValue := value;
    end;
  end;

  /// <summary>The text displayed in the text box, which is either the entered text or the placeholder text.</summary>
  public property DisplayText: String
  begin
    get
    begin
      if TextValue.Length > 0 then
      begin
        return TextValue;
      end;

      return PlaceholderTextValue;
    end;
  end;

  /// <summary>The padding inside the text box.</summary>
  public property Padding: Thickness
  begin
    get
    begin
      return PaddingValue;
    end;

    set(value)
    begin
      if value = nil then
      begin
        PaddingValue := new Thickness();
        return;
      end;

      PaddingValue := value;
    end;
  end;

  /// <summary>The command to execute when the text changes.</summary>
  public property TextChangedCommand: ICommand
  begin
    get
    begin
      return TextChangedCommandValue;
    end;

    set(value)
    begin
      TextChangedCommandValue := value;
    end;
  end;

  /// <summary>A value indicating whether the text box can notify about text changes.</summary>
  public property CanNotifyTextChanged: Boolean
  begin
    get
    begin
      return TextChangedCommandValue <> nil and TextChangedCommandValue.CanExecute();
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="TextBox"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeView();
    TextValue := '';
    PlaceholderTextValue := '';
    IsReadOnlyValue := false;
    PaddingValue := new Thickness();
    TextChangedCommandValue := nil;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Clear
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Clears the text in the text box if it is not read-only.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Clear;
  begin
    if IsReadOnlyValue then
    begin
      return;
    end;

    TextValue := '';
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • NotifyTextChanged
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Notifies that the text has changed.</summary>
  /// <returns><c>true</c> if the text changed command was executed; otherwise, <c>false</c>.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function NotifyTextChanged: Boolean;
  begin
    if CanNotifyTextChanged = false then
    begin
      return false;
    end;

    TextChangedCommandValue.Execute();
    return true;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • TextBinding
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>
///   Represents a binding between an <see cref="ObservableText"/> source and a target text property, allowing for efficient updates by tracking
///   the version of the source text.
/// </summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class TextBinding
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The source of the text for the binding.</summary>
  private var SourceValue: ObservableText;
  /// <summary>The last applied version of the source text, used to determine if the binding is dirty and needs to be reapplied.</summary>
  private var LastAppliedVersionValue: Integer;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets a value indicating whether the binding is dirty and needs to be reapplied.</summary>
  public property IsDirty: Boolean
  begin
    get
    begin
      if SourceValue = nil then
      begin
        return false;
      end;

      return SourceValue.ChangeVersion <> LastAppliedVersionValue;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="TextBinding"/> class with the specified source.</summary>
  /// <param name="source">The source of the text for the binding.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor(source: ObservableText);
  begin
    SourceValue := source;
    LastAppliedVersionValue := -1;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Apply
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Applies the binding to the specified target text block, updating its text if the binding is dirty.</summary>
  /// <param name="target">The target text block to apply the binding to.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Apply(target: TextBlock);
  begin
    if SourceValue = nil or target = nil then
    begin
      return;
    end;

    target.Text := SourceValue.Text;
    LastAppliedVersionValue := SourceValue.ChangeVersion;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • ApplyToTextBox
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>
  ///   Applies the binding to the specified target text box, updating its text if the binding is dirty and the text box is not read-only.
  /// </summary>
  /// <param name="target">The target text box to apply the binding to.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method ApplyToTextBox(target: TextBox);
  begin
    if SourceValue = nil or target = nil then
    begin
      return;
    end;

    target.Text := SourceValue.Text;
    LastAppliedVersionValue := SourceValue.ChangeVersion;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • ItemsControl<T>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that displays a collection of items, allowing for data binding and templating of the items.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class ItemsControl<T>: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The source collection of items to display in the control.</summary>
  private var ItemsSourceValue: IEnumerable<T>;
  /// <summary>The text to display when the items source is empty.</summary>
  private var EmptyTextValue: String;
  /// <summary>A selector function that creates a view for a given item in the items source.</summary>
  private var ItemTemplateValue: Selector<T, View>;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The source collection of items to display in the control.</summary>
  public property ItemsSource: IEnumerable<T>
  begin
    get
    begin
      return ItemsSourceValue;
    end;

    set(value)
    begin
      ItemsSourceValue := value;
    end;
  end;

  /// <summary>The text to display when the items source is empty.</summary>
  public property EmptyText: String
  begin
    get
    begin
      return EmptyTextValue;
    end;

    set(value)
    begin
      EmptyTextValue := value;
    end;
  end;

  /// <summary>A selector function that creates a view for a given item in the items source.</summary>
  public property ItemTemplate: Selector<T, View>
  begin
    get
    begin
      return ItemTemplateValue;
    end;

    set(value)
    begin
      ItemTemplateValue := value;
    end;
  end;

  /// <summary>The number of items in the control.</summary>
  public property ItemCount: Integer
  begin
    get
    begin
      if ItemsSourceValue = nil then
      begin
        return 0;
      end;

      var enumerator := ItemsSourceValue.GetEnumerator();
      var count := 0;
      while enumerator.MoveNext() do
      begin
        count := count + 1;
      end;

      return count;
    end;
  end;

  /// <summary>Indicates whether the control has any items.</summary>
  public property HasItems: Boolean
  begin
    get
    begin
      return ItemCount > 0;
    end;
  end;

  /// <summary>Indicates whether the control has an item template.</summary>  
  public property HasItemTemplate: Boolean
  begin
    get
    begin
      return ItemTemplateValue <> nil;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="ItemsControl{T}"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeItemsControl();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • GetItemsSourceCore
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>
  ///   Gets the items source for the control. This method can be overridden by derived classes to provide custom logic for retrieving the 
  ///   items source.
  /// </summary>
  /// <returns>The items source for the control.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  protected function GetItemsSourceCore: IEnumerable<T>;
  begin
    return ItemsSourceValue;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • InitializeItemsControl
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes the items control.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  protected method InitializeItemsControl;
  begin
    InitializeView();
    ItemsSourceValue := nil;
    EmptyTextValue := '';
    ItemTemplateValue := nil;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • BuildItems
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Builds the items for the control.</summary>
  /// <returns>A list of views representing the items.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function BuildItems: List<View>;
  begin
    var builtItems := new List<View>();
    var itemsSource := GetItemsSourceCore();
    if itemsSource = nil or ItemTemplateValue = nil then
    begin
      return builtItems;
    end;

    var enumerator := itemsSource.GetEnumerator();
    while enumerator.MoveNext() do
    begin
      var itemView := ItemTemplateValue(enumerator.Current);
      if itemView <> nil then
      begin
        builtItems.Add(itemView);
      end;
    end;

    return builtItems;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • ListView<T>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that displays a list of items, allowing for selection of a single item.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class ListView<T>: ItemsControl<T>
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The index of the currently selected item in the control, or -1 if no item is selected.</summary>
  private var SelectedIndexValue: Integer;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the index of the currently selected item in the control, or -1 if no item is selected.</summary>
  public property SelectedIndex: Integer
  begin
    get
    begin
      return SelectedIndexValue;
    end;
  end;

  /// <summary>Gets a value indicating whether the control has a selected item.</summary>
  public property HasSelection: Boolean
  begin
    get
    begin
      return SelectedIndexValue >= 0 and SelectedIndexValue < ItemCount;
    end;
  end;

  /// <summary>Gets the currently selected item in the control.</summary>
  public property SelectedItem: T
  begin
    get
    begin
      if HasSelection = false then
      begin
        return nil;
      end;

      var itemsSource := GetItemsSourceCore();
      if itemsSource = nil then
      begin
        return nil;
      end;

      var enumerator := itemsSource.GetEnumerator();
      var index := 0;
      while enumerator.MoveNext() do
      begin
        if index = SelectedIndexValue then
        begin
          return enumerator.Current;
        end;

        index := index + 1;
      end;

      return nil;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="ListView{T}"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeItemsControl();
    SelectedIndexValue := -1;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • SelectIndex
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Selects the item at the specified index.</summary>
  /// <param name="index">The index of the item to select.</param>
  /// <returns><c>true</c> if the item was successfully selected; otherwise, <c>false</c>.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function SelectIndex(index: Integer): Boolean;
  begin
    if index < 0 or index >= ItemCount then
    begin
      SelectedIndexValue := -1;
      return false;
    end;

    SelectedIndexValue := index;
    return true;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • ClearSelection
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Clears the current selection.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method ClearSelection;
  begin
    SelectedIndexValue := -1;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Grid
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that displays a grid of rows and columns, allowing for the arrangement of child views in a tabular layout.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Grid: Panel
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The number of rows in the grid.</summary>
  private var RowsValue: Integer;
  /// <summary>The number of columns in the grid.</summary>
  private var ColumnsValue: Integer;
  /// <summary>A value indicating whether to show grid lines between the cells.</summary>
  private var ShowGridLinesValue: Boolean;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the number of rows in the grid.</summary>
  public property Rows: Integer
  begin
    get
    begin
      return RowsValue;
    end;
  end;

  /// <summary>Gets the number of columns in the grid.</summary>
  public property Columns: Integer
  begin
    get
    begin
      return ColumnsValue;
    end;
  end;

  /// <summary>Gets the total number of cells in the grid.</summary>
  public property CellCount: Integer
  begin
    get
    begin
      return RowsValue * ColumnsValue;
    end;
  end;

  /// <summary>Gets or sets a value indicating whether to show grid lines between the cells.</summary>
  public property ShowGridLines: Boolean
  begin
    get
    begin
      return ShowGridLinesValue;
    end;

    set(value)
    begin
      ShowGridLinesValue := value;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Grid"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeContainer();
    RowsValue := 1;
    ColumnsValue := 1;
    ShowGridLinesValue := false;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • SetDimensions
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Sets the number of rows and columns in the grid.</summary>
  /// <param name="rows">The number of rows.</param>
  /// <param name="columns">The number of columns.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method SetDimensions(rows: Integer; columns: Integer);
  begin
    if rows <= 0 then
    begin
      RowsValue := 1;
    end
    else
    begin
      RowsValue := rows;
    end;

    if columns <= 0 then
    begin
      ColumnsValue := 1;
    end
    else
    begin
      ColumnsValue := columns;
    end;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Border
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>
///   Represents a view that displays a border around its child view, allowing for customization of the border thickness, background, and padding.
/// </summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Border: ContentControl
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The thickness of the border around the child view.</summary>
  private var BorderThicknessValue: Integer;
  /// <summary>The background color of the border.</summary>
  private var BackgroundValue: Color;
  /// <summary>The padding inside the border.</summary>
  private var PaddingValue: Thickness;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the child view of the border.</summary>
  public property Child: View
  begin
    get
    begin
      return GetContentCore();
    end;

    set(value)
    begin
      SetContentCore(value);
    end;
  end;

  /// <summary>Gets or sets the thickness of the border around the child view.</summary>
  public property BorderThickness: Integer
  begin
    get
    begin
      return BorderThicknessValue;
    end;

    set(value)
    begin
      if value < 0 then
      begin
        BorderThicknessValue := 0;
      end
      else
      begin
        BorderThicknessValue := value;
      end;
    end;
  end;

  /// <summary>Gets a value indicating whether the border has a child view.</summary>
  public property HasChild: Boolean
  begin
    get
    begin
      return HasContent;
    end;
  end;

  /// <summary>Gets or sets the background color of the border.</summary>
  public property Background: Color
  begin
    get
    begin
      return BackgroundValue;
    end;

    set(value)
    begin
      BackgroundValue := value;
    end;
  end;

  /// <summary>Gets or sets the padding inside the border.</summary>
  public property Padding: Thickness
  begin
    get
    begin
      return PaddingValue;
    end;

    set(value)
    begin
      if value = nil then
      begin
        PaddingValue := new Thickness();
        return;
      end;

      PaddingValue := value;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Border"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeContentControl();
    BorderThicknessValue := 0;
    BackgroundValue := Color.Transparent;
    PaddingValue := new Thickness();
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • ScrollViewer
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a scrollable area that can contain a single child element.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class ScrollViewer: ContentControl
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The horizontal offset of the scroll viewer.</summary>
  private var HorizontalOffsetValue: Integer;
  /// <summary>The vertical offset of the scroll viewer.</summary>
  private var VerticalOffsetValue: Integer;
  /// <summary>The width of the viewport of the scroll viewer.</summary>
  private var ViewportWidthValue: Integer;
  /// <summary>The height of the viewport of the scroll viewer.</summary>
  private var ViewportHeightValue: Integer;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets the horizontal offset of the scroll viewer.</summary>
  public property HorizontalOffset: Integer
  begin
    get
    begin
      return HorizontalOffsetValue;
    end;
  end;

  /// <summary>Gets the vertical offset of the scroll viewer.</summary>
  public property VerticalOffset: Integer
  begin
    get
    begin
      return VerticalOffsetValue;
    end;
  end;

  /// <summary>Gets or sets the width of the viewport of the scroll viewer.</summary>
  public property ViewportWidth: Integer
  begin
    get
    begin
      return ViewportWidthValue;
    end;

    set(value)
    begin
      if value < 0 then
      begin
        ViewportWidthValue := 0;
      end
      else
      begin
        ViewportWidthValue := value;
      end;
    end;
  end;

  /// <summary>Gets or sets the height of the viewport of the scroll viewer.</summary>
  public property ViewportHeight: Integer
  begin
    get
    begin
      return ViewportHeightValue;
    end;

    set(value)
    begin
      if value < 0 then
      begin
        ViewportHeightValue := 0;
      end
      else
      begin
        ViewportHeightValue := value;
      end;
    end;
  end;

  /// <summary>Gets a value indicating whether the scroll viewer can scroll.</summary>
  public property CanScroll: Boolean
  begin
    get
    begin
      return HasContent and (ViewportWidthValue > 0 or ViewportHeightValue > 0);
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="ScrollViewer"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeContentControl();
    HorizontalOffsetValue := 0;
    VerticalOffsetValue := 0;
    ViewportWidthValue := 0;
    ViewportHeightValue := 0;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • ScrollTo
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Scrolls the content to the specified horizontal and vertical offsets.</summary>
  /// <param name="horizontalOffset">The horizontal offset to scroll to.</param>
  /// <param name="verticalOffset">The vertical offset to scroll to.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method ScrollTo(horizontalOffset: Integer; verticalOffset: Integer);
  begin
    if horizontalOffset < 0 then
    begin
      HorizontalOffsetValue := 0;
    end
    else
    begin
      HorizontalOffsetValue := horizontalOffset;
    end;

    if verticalOffset < 0 then
    begin
      VerticalOffsetValue := 0;
    end
    else
    begin
      VerticalOffsetValue := verticalOffset;
    end;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • MenuItem
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents an item in a menu, which can have a header, an associated command, and child menu items for creating submenus.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class MenuItem: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The header text of the menu item.</summary>
  private var HeaderValue: String;
  /// <summary>The command associated with the menu item, which is executed when the item is invoked.</summary>
  private var CommandValue: ICommand;
  /// <summary>The child menu items of the menu item, used for creating submenus.</summary>
  private var ItemsValue: List<MenuItem>;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The header text of the menu item.</summary>
  public property Header: String
  begin
    get
    begin
      return HeaderValue;
    end;

    set(value)
    begin
      HeaderValue := value;
    end;
  end;

  /// <summary>The command associated with the menu item, which is executed when the item is invoked.</summary>
  public property Command: ICommand
  begin
    get
    begin
      return CommandValue;
    end;

    set(value)
    begin
      CommandValue := value;
    end;
  end;

  /// <summary>The child menu items of the menu item, used for creating submenus.</summary>
  public property Items: List<MenuItem>
  begin
    get
    begin
      return ItemsValue;
    end;
  end;

  /// <summary>The number of child menu items.</summary>
  public property ItemCount: Integer
  begin
    get
    begin
      return ItemsValue.Count;
    end;
  end;

  /// <summary>Indicates whether the command associated with the menu item can be executed.</summary>
  public property CanExecute: Boolean
  begin
    get
    begin
      return CommandValue <> nil and CommandValue.CanExecute();
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="MenuItem"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeView();
    HeaderValue := '';
    CommandValue := nil;
    ItemsValue := new List<MenuItem>();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • AddItem
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Adds a child menu item to the menu item.</summary>
  /// <param name="item">The menu item to add.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method AddItem(item: MenuItem);
  begin
    if item = nil then
    begin
      raise new Exception('Menu item must not be nil.');
    end;

    ItemsValue.Add(item);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Invoke
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Invokes the command associated with the menu item.</summary>
  /// <returns>True if the command was executed; otherwise, false.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function Invoke: Boolean;
  begin
    if CanExecute = false then
    begin
      return false;
    end;

    CommandValue.Execute();
    return true;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// CLASS • MenuBar
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that displays a menu bar, which can contain multiple menu items for organizing commands and actions.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class MenuBar: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The menu items contained in the menu bar.</summary>
  private var ItemsValue: List<MenuItem>;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The menu items contained in the menu bar.</summary>
  public property Items: List<MenuItem>
  begin
    get
    begin
      return ItemsValue;
    end;
  end;

  /// <summary>The number of menu items in the menu bar.</summary>
  public property ItemCount: Integer
  begin
    get
    begin
      return ItemsValue.Count;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="MenuBar"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeView();
    ItemsValue := new List<MenuItem>();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • AddItem
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Adds a menu item to the menu bar.</summary>
  /// <param name="item">The menu item to add.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method AddItem(item: MenuItem);
  begin
    if item = nil then
    begin
      raise new Exception('Menu item must not be nil.');
    end;

    ItemsValue.Add(item);
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
