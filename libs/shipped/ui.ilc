//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// CLASS • NavigationHost
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>Represents a view that serves as a navigation host, allowing for the display of pages and navigation between them.</summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class NavigationHost: View
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The currently displayed page in the navigation host.</summary>
  private var CurrentPageValue: Page;
  /// <summary>The history of pages that have been navigated to, used for implementing back navigation.</summary>
  private var BackHistoryValue: List<Page>;
  /// <summary>The number of entries in the back navigation history.</summary>
  private var BackHistoryCountValue: Integer;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the currently displayed page in the navigation host.</summary>
  public property CurrentPage: Page
  begin
    get
    begin
      return CurrentPageValue;
    end;

    set(value)
    begin
      CurrentPageValue := value;
    end;
  end;

  /// <summary>Gets a value indicating whether there is a page currently displayed in the navigation host.</summary>
  public property HasPage: Boolean
  begin
    get
    begin
      return CurrentPageValue <> nil;
    end;
  end;

  /// <summary>Gets a value indicating whether there is a page to navigate back to in the navigation host.</summary>
  public property CanGoBack: Boolean
  begin
    get
    begin
      return BackHistoryCountValue > 0;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="NavigationHost"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    InitializeView();
    CurrentPageValue := nil;
    BackHistoryValue := new List<Page>();
    BackHistoryCountValue := 0;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Navigate
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Navigates to the specified page.</summary>
  /// <param name="page">The page to navigate to.</param>
  /// <returns><c>true</c> if the navigation was successful; otherwise, <c>false</c>.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function Navigate(page: Page): Boolean;
  begin
    if page = nil then
    begin
      return false;
    end;

    if CurrentPageValue <> nil then
    begin
      if BackHistoryCountValue < BackHistoryValue.Count then
      begin
        BackHistoryValue[BackHistoryCountValue] := CurrentPageValue;
      end
      else
      begin
        BackHistoryValue.Add(CurrentPageValue);
      end;

      BackHistoryCountValue := BackHistoryCountValue + 1;
    end;

    CurrentPageValue := page;
    InheritDataContextTo(CurrentPageValue);
    return true;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • GoBack
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Navigates back to the previous page in the navigation host.</summary>
  /// <returns><c>true</c> if the navigation was successful; otherwise, <c>false</c>.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function GoBack: Boolean;
  begin
    if CanGoBack = false then
    begin
      return false;
    end;

    BackHistoryCountValue := BackHistoryCountValue - 1;
    CurrentPageValue := BackHistoryValue[BackHistoryCountValue];
    return true;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Window
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>
///   Represents a window that can display content, with properties for title, size, background, and methods for showing and closing the window.
/// </summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Window
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The title of the window, displayed in the title bar.</summary>
  private var TitleValue: String;
  /// <summary>The content displayed in the window.</summary>
  private var ContentValue: View;
  /// <summary>A value indicating whether the window is currently open and visible to the user.</summary>
  private var IsOpenValue: Boolean;
  /// <summary>The width of the window.</summary>
  private var WidthValue: Integer;
  /// <summary>The height of the window.</summary>
  private var HeightValue: Integer;
  /// <summary>The minimum width of the window.</summary>
  private var MinWidthValue: Integer;
  /// <summary>The minimum height of the window.</summary>
  private var MinHeightValue: Integer;
  /// <summary>The background color of the window.</summary>
  private var BackgroundValue: Color;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
   /// <summary>Gets or sets the title of the window, displayed in the title bar.</summary>
  public property Title: String
  begin
    get
    begin
      return TitleValue;
    end;

    set(value)
    begin
      TitleValue := value;
    end;
  end;

  /// <summary>Gets or sets the content displayed in the window.</summary>
  public property Content: View
  begin
    get
    begin
      return ContentValue;
    end;

    set(value)
    begin
      ContentValue := value;
    end;
  end;

  /// <summary>Gets a value indicating whether the window is currently open and visible to the user.</summary>
  public property IsOpen: Boolean
  begin
    get
    begin
      return IsOpenValue;
    end;
  end;

  /// <summary>Gets the width of the window.</summary>
  public property Width: Integer
  begin
    get
    begin
      return WidthValue;
    end;
  end;

  /// <summary>Gets the height of the window.</summary>
  public property Height: Integer
  begin
    get
    begin
      return HeightValue;
    end;
  end;

  /// <summary>Gets or sets the background color of the window.</summary>
  public property Background: Color
  begin
    get
    begin
      return BackgroundValue;
    end;

    set(value)
    begin
      BackgroundValue := value;
    end;
  end;

  /// <summary>Gets or sets the minimum width of the window.</summary>
  public property MinWidth: Integer
  begin
    get
    begin
      return MinWidthValue;
    end;

    set(value)
    begin
      if value < 0 then
      begin
        MinWidthValue := 0;
      end
      else
      begin
        MinWidthValue := value;
      end;

      if WidthValue < MinWidthValue then
      begin
        WidthValue := MinWidthValue;
      end;
    end;
  end;

  /// <summary>Gets or sets the minimum height of the window.</summary>
  public property MinHeight: Integer
  begin
    get
    begin
      return MinHeightValue;
    end;

    set(value)
    begin
      if value < 0 then
      begin
        MinHeightValue := 0;
      end
      else
      begin
        MinHeightValue := value;
      end;

      if HeightValue < MinHeightValue then
      begin
        HeightValue := MinHeightValue;
      end;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Window"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    TitleValue := '';
    ContentValue := nil;
    IsOpenValue := false;
    WidthValue := 640;
    HeightValue := 480;
    MinWidthValue := 0;
    MinHeightValue := 0;
    BackgroundValue := Color.White;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Show
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Shows the window, making it open and visible to the user.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Show;
  begin
    IsOpenValue := true;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Close
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Closes the window, making it no longer open or visible to the user.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Close;
  begin
    IsOpenValue := false;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Resize
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Resizes the window to the specified width and height, respecting the minimum size constraints.</summary>
  /// <param name="width">The new width of the window.</param>
  /// <param name="height">The new height of the window.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Resize(width: Integer; height: Integer);
  begin
    if width < MinWidthValue then
    begin
      WidthValue := MinWidthValue;
    end
    else
    begin
      WidthValue := width;
    end;

    if height < MinHeightValue then
    begin
      HeightValue := MinHeightValue;
    end
    else
    begin
      HeightValue := height;
    end;
  end;

  /// <summary>Sets the minimum window size and clamps the current size to that constraint.</summary>
  public method SetMinimumSize(width: Integer; height: Integer);
  begin
    MinWidth := width;
    MinHeight := height;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Dialog
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>
///   Represents a dialog window that can display a message and return a result indicating whether the dialog was accepted or cancelled.
/// </summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Dialog: Window
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The message displayed in the dialog.</summary>
  private var MessageValue: String;
  /// <summary>The result of the dialog, indicating whether it was accepted or cancelled.</summary>
  private var ResultValue: DialogResult;
  /// <summary>A value indicating whether the dialog is currently shown as a modal dialog.</summary>
  private var IsModalValue: Boolean;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Gets or sets the message displayed in the dialog.</summary>
  public property Message: String
  begin
    get
    begin
      return MessageValue;
    end;

    set(value)
    begin
      MessageValue := value;
    end;
  end;

  /// <summary>Gets the result of the dialog, indicating whether it was accepted or cancelled.</summary>
  public property Result: DialogResult
  begin
    get
    begin
      return ResultValue;
    end;
  end;

  /// <summary>Gets a value indicating whether the dialog is currently shown as a modal dialog.</summary>
  public property IsModal: Boolean
  begin
    get
    begin
      return IsModalValue;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Dialog"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    MessageValue := '';
    ResultValue := DialogResult.None;
    IsModalValue := false;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • ShowDialog
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>
  ///   Shows the dialog as a modal dialog, blocking interaction with other windows until the dialog is accepted or cancelled, and returns the
  ///   result of the dialog.
  /// </summary>
  /// <returns>The result of the dialog, indicating whether it was accepted or cancelled.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function ShowDialog: DialogResult;
  begin
    Show();
    IsModalValue := true;
    ResultValue := DialogResult.None;
    return ResultValue;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Accept
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Accepts the dialog, setting the result to <see cref="DialogResult.Accepted"/> and closing the dialog.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Accept;
  begin
    ResultValue := DialogResult.Accepted;
    IsModalValue := false;
    Close();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Cancel
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Cancels the dialog, setting the result to <see cref="DialogResult.Cancelled"/> and closing the dialog.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method Cancel;
  begin
    ResultValue := DialogResult.Cancelled;
    IsModalValue := false;
    Close();
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// • CLASS • Application
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
/// <summary>
///   Represents the application that manages the main event loop and the windows of the application, allowing for adding and managing windows.
/// </summary>
//══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
public class Application
begin
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • FIELDS •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The windows currently managed by the application.</summary>
  private var WindowsValue: List<Window>;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • PROPERTIES •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>The windows currently managed by the application.</summary>
  public property Windows: List<Window>
  begin
    get
    begin
      return WindowsValue;
    end;
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • CONSTRUCTOR •
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Initializes a new instance of the <see cref="Application"/> class.</summary>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public constructor;
  begin
    WindowsValue := new List<Window>();
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • AddWindow
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Adds a window to the application, allowing it to be managed and displayed by the application.</summary>
  /// <param name="window">The window to add to the application.</param>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public method AddWindow(window: Window);
  begin
    if window = nil then
    begin
      raise new Exception('UI window must not be nil.');
    end;

    WindowsValue.Add(window);
  end;

  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  // • METHOD • Run
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  /// <summary>Runs the application, displaying all managed windows.</summary>
  /// <returns>The number of windows shown.</returns>
  //————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
  public function Run: Integer;
  begin
    var shown := 0;
    var index := 0;
    while index < WindowsValue.Count do
    begin
      WindowsValue[index].Show();
      shown := shown + 1;
      index := index + 1;
    end;

    return shown;
  end;
end;
//══ end of class ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

//══ end of file ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
